---
import type { CaseStudy } from '../../utils/caseStudies';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { Check, ArrowRight } from '@lucide/astro';

interface Props {
  project: CaseStudy;
}
const { project } = Astro.props;
const { data } = project;
---

<Section tone="paper-2" aria-labelledby="outcomes-heading">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <SectionHeading id="outcomes-heading" eyebrow="Outcomes" title="What changed" size="md" />
      <ul class="mt-8 space-y-4">
        {data.outcome.map((item) => (
          <li class="flex gap-3">
            <span class="mt-1 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-800">
              <Check class="size-3.5" aria-hidden="true" />
            </span>
            <span class="text-body text-ink-2">{item}</span>
          </li>
        ))}
      </ul>
    </div>
    {data.nextImprovements.length > 0 && (
      <div class="lg:col-span-5">
        <h3 class="text-display-sm text-ink">What we'd do next</h3>
        <p class="mt-2 text-small text-ink-3">Honest next steps, in priority order.</p>
        <ol class="mt-6 space-y-4">
          {data.nextImprovements.map((item, i) => (
            <li class="flex gap-3">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full border border-line bg-surface text-small font-semibold text-ink">{i + 1}</span>
              <span class="text-small text-ink-2">{item}</span>
            </li>
          ))}
        </ol>
      </div>
    )}
  </div>
</Section>
