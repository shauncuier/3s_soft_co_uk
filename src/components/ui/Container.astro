---
interface Props {
  size?: 'content' | 'prose' | 'narrow';
  as?: 'div' | 'section' | 'article' | 'nav' | 'header' | 'footer';
  class?: string;
}
const { size = 'content', as: Tag = 'div', class: className = '' } = Astro.props;
const sizes = { content: 'max-w-content', prose: 'max-w-prose', narrow: 'max-w-narrow' };
---

<Tag class:list={['mx-auto w-full px-5 sm:px-8', sizes[size], className]}>
  <slot />
</Tag>
