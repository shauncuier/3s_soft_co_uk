---
import { getImage } from 'astro:assets';
import Layout from './Layout.astro';
import Hero from '../components/case-study/Hero.astro';
import Meta from '../components/case-study/Meta.astro';
import Narrative from '../components/case-study/Narrative.astro';
import Outcomes from '../components/case-study/Outcomes.astro';
import Gallery from '../components/case-study/Gallery.astro';
import Related from '../components/case-study/Related.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Section from '../components/ui/Section.astro';
import type { CaseStudy } from '../utils/caseStudies';

interface Props {
  project: CaseStudy;
}
const { project } = Astro.props;
const { data } = project;

const og = await getImage({ src: data.heroImage, width: 1200, height: 630, format: 'jpg', fit: 'cover', position: 'top' });
---

<Layout
  title={`${data.title} — Case Study`}
  description={data.summary}
  ogImage={og.src}
  breadcrumbs={[{ label: 'Work', href: '/work/' }, { label: data.title }]}
  caseStudy={{
    title: data.title,
    summary: data.summary,
    heroImageUrl: og.src,
    publishDate: data.publishDate,
    industry: data.industry,
    categoryLabel: data.categoryLabel,
    client: data.client,
    liveUrl: data.liveUrl,
  }}
>
  <Hero project={project} />

  <Section padding="sm">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <Narrative project={project}>
          <slot />
        </Narrative>
      </div>
      <div class="lg:col-span-4">
        <Meta project={project} />
      </div>
    </div>
  </Section>

  <Outcomes project={project} />
  <Gallery project={project} />
  <Related project={project} />
  <CtaBand title="Want this kind of result for your business?" lede="Tell us what you sell and where you sell it. We'll suggest the smallest piece of work that would make a real difference." />
</Layout>
