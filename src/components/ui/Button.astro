---
/**
 * Button — the only button/link-button style on the site. Pill shaped.
 * Renders <a> when `href` is given, otherwise <button>.
 * `arrow` adds the trailing arrow-in-a-circle used by the primary actions.
 */
import type { HTMLAttributes } from 'astro/types';
import { ArrowRight } from '@lucide/astro';

type Variant = 'primary' | 'secondary' | 'ink' | 'ghost' | 'link' | 'primary-on-dark' | 'secondary-on-dark';
type Size = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  variant?: Variant;
  size?: Size;
  type?: 'button' | 'submit' | 'reset';
  external?: boolean;
  disabled?: boolean;
  arrow?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  external = false,
  disabled = false,
  arrow = false,
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'group/btn inline-flex items-center justify-center gap-2 rounded-full font-semibold leading-none whitespace-nowrap transition-[background-color,color,border-color,transform] duration-180 ease-soft select-none disabled:opacity-50 disabled:pointer-events-none active:scale-[0.98]';

const variants: Record<Variant, string> = {
  primary: 'bg-brand text-white hover:bg-brand-700',
  secondary: 'bg-surface text-ink border border-line-strong hover:border-ink',
  ink: 'bg-ink text-paper hover:bg-graphite-2',
  ghost: 'text-ink hover:bg-paper-2',
  link: 'text-brand-700 hover:text-brand-800 underline underline-offset-[0.2em] decoration-brand-700/40 hover:decoration-brand-800 px-0 py-0 rounded-none',
  'primary-on-dark': 'bg-paper text-ink hover:bg-white',
  'secondary-on-dark': 'text-on-graphite border border-white/25 hover:border-white/60 hover:bg-white/10',
};

const circle: Record<Variant, string> = {
  primary: 'bg-white/20 text-white',
  secondary: 'bg-ink text-paper',
  ink: 'bg-paper text-ink',
  ghost: 'bg-ink text-paper',
  link: '',
  'primary-on-dark': 'bg-ink text-paper',
  'secondary-on-dark': 'bg-paper text-ink',
};

const sizes: Record<Size, string> = {
  sm: 'text-small py-2 pl-4 pr-4',
  md: 'text-body py-2.5 pl-5 pr-5',
  lg: 'text-body py-3 pl-6 pr-6',
};
const sizesArrow: Record<Size, string> = {
  sm: 'text-small py-1.5 pl-4 pr-1.5',
  md: 'text-body py-2 pl-5 pr-2',
  lg: 'text-body py-2.5 pl-6 pr-2.5',
};
const circleSize: Record<Size, string> = { sm: 'size-7', md: 'size-8', lg: 'size-9' };

const classes = [base, variants[variant], variant === 'link' ? '' : arrow ? sizesArrow[size] : sizes[size], className];
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a href={href} class:list={classes} {...externalAttrs} {...rest}>
    <slot />
    {arrow && (
      <span class:list={['inline-flex shrink-0 items-center justify-center rounded-full', circle[variant], circleSize[size]]} aria-hidden="true">
        <ArrowRight class="size-4 transition-transform duration-180 group-hover/btn:translate-x-0.5" />
      </span>
    )}
  </a>
) : (
  <button type={type} class:list={classes} disabled={disabled || undefined} {...(rest as any)}>
    <slot />
    {arrow && (
      <span class:list={['inline-flex shrink-0 items-center justify-center rounded-full', circle[variant], circleSize[size]]} aria-hidden="true">
        <ArrowRight class="size-4 transition-transform duration-180 group-hover/btn:translate-x-0.5" />
      </span>
    )}
  </button>
)}
