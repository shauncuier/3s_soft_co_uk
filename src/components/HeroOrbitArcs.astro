---
/**
 * HeroOrbitArcs.astro
 *
 * Forge Studio-inspired concentric orbiting arcs with counter-rotating technology badges.
 * Technologies orbit smoothly along circular guide paths while maintaining upright orientation.
 */

interface TechItem {
  name: string;
  angle: number; // degrees
  color: string;
  badge: string;
}

const outerTechs: TechItem[] = [
  { name: 'Shopify Plus', angle: 25, color: '#95BF47', badge: 'E-Commerce' },
  { name: 'Amazon Ads & Ops', angle: 85, color: '#FF9900', badge: 'Marketplaces' },
  { name: 'WooCommerce HPOS', angle: 145, color: '#96588A', badge: 'Custom Plugins' },
  { name: 'Astro Web', angle: 205, color: '#FF5D01', badge: 'Headless' },
  { name: 'React & Next.js', angle: 265, color: '#61DAFB', badge: 'App Frontend' },
  { name: 'Stripe Payments', angle: 325, color: '#635BFF', badge: 'Checkout' },
];

const innerTechs: TechItem[] = [
  { name: 'Tailwind CSS', angle: 45, color: '#38BDF8', badge: 'Styling' },
  { name: 'WordPress Core', angle: 165, color: '#21759B', badge: 'CMS' },
  { name: 'eBay Marketplace', angle: 285, color: '#E53238', badge: 'Syndication' },
];
---

<div class="pointer-events-none absolute inset-0 overflow-hidden flex items-center justify-center select-none" aria-hidden="true">
  
  <!-- Subtle Architectural Radial Grid Glow -->
  <div class="absolute w-[900px] h-[900px] rounded-full bg-emerald-500/[0.04] blur-[140px] pointer-events-none"></div>

  <!-- Ambient Concentric Circular Guide Rings -->
  <div class="absolute w-[560px] h-[560px] sm:w-[680px] sm:h-[680px] lg:w-[860px] lg:h-[860px] rounded-full border border-white/[0.05]"></div>
  <div class="absolute w-[380px] h-[380px] sm:w-[460px] sm:h-[460px] lg:w-[580px] lg:h-[580px] rounded-full border border-white/[0.04] border-dashed"></div>
  <div class="absolute w-[220px] h-[220px] sm:w-[280px] sm:h-[280px] rounded-full border border-emerald-500/[0.08]"></div>

  <!-- ============================================================ -->
  <!-- OUTER ORBIT TRACK                                            -->
  <!-- ============================================================ -->
  <div
    class="absolute w-[560px] h-[560px] sm:w-[680px] sm:h-[680px] lg:w-[860px] lg:h-[860px] rounded-full animate-spin-orbit"
    style="--orbit-duration: 110s;"
  >
    {outerTechs.map((tech) => {
      return (
        <div
          class="absolute top-1/2 left-1/2 w-0 h-0"
          style={`transform: rotate(${tech.angle}deg) translateX(clamp(280px, 43vw, 430px));`}
        >
          <!-- Counter-rotation wrapper: cancels parent spin so badge remains level -->
          <div style={`transform: rotate(-${tech.angle}deg);`}>
            <div class="animate-spin-orbit-reverse" style="--orbit-duration: 110s;">
              
              <!-- Orbiting Tech Pill Badge -->
              <div class="pointer-events-auto -translate-x-1/2 -translate-y-1/2 flex items-center gap-2.5 px-3.5 py-2 rounded-full bg-[#111413]/90 border border-white/[0.12] backdrop-blur-xl shadow-2xl hover:border-emerald-500/60 hover:scale-105 transition-all duration-300 group cursor-default">
                <!-- Color Indicator Pip -->
                <span
                  class="w-2 h-2 rounded-full shrink-0 shadow-xs"
                  style={`background-color: ${tech.color}; box-shadow: 0 0 10px ${tech.color}88;`}
                ></span>
                
                <div class="flex flex-col text-left">
                  <span class="text-[11px] font-bold font-mono tracking-tight text-white group-hover:text-emerald-300 transition-colors whitespace-nowrap">
                    {tech.name}
                  </span>
                  <span class="text-[9px] font-mono uppercase tracking-widest text-neutral-400 whitespace-nowrap">
                    {tech.badge}
                  </span>
                </div>
              </div>

            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- ============================================================ -->
  <!-- INNER ORBIT TRACK (Opposite rotation direction)              -->
  <!-- ============================================================ -->
  <div
    class="absolute w-[380px] h-[380px] sm:w-[460px] sm:h-[460px] lg:w-[580px] lg:h-[580px] rounded-full animate-spin-orbit-reverse hidden sm:block"
    style="--orbit-duration: 85s;"
  >
    {innerTechs.map((tech) => {
      return (
        <div
          class="absolute top-1/2 left-1/2 w-0 h-0"
          style={`transform: rotate(${tech.angle}deg) translateX(clamp(190px, 29vw, 290px));`}
        >
          <!-- Counter-rotation wrapper -->
          <div style={`transform: rotate(-${tech.angle}deg);`}>
            <div class="animate-spin-orbit" style="--orbit-duration: 85s;">
              
              <!-- Orbiting Tech Pill Badge -->
              <div class="pointer-events-auto -translate-x-1/2 -translate-y-1/2 flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#0c0e0d]/90 border border-white/[0.08] backdrop-blur-md shadow-xl hover:border-emerald-400/50 hover:scale-105 transition-all duration-300 group cursor-default">
                <span
                  class="w-1.5 h-1.5 rounded-full shrink-0"
                  style={`background-color: ${tech.color}; box-shadow: 0 0 8px ${tech.color}66;`}
                ></span>
                <span class="text-[10px] font-mono font-medium text-neutral-300 group-hover:text-white transition-colors whitespace-nowrap">
                  {tech.name}
                </span>
              </div>

            </div>
          </div>
        </div>
      );
    })}
  </div>

</div>
