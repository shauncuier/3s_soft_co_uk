---
interface Props {
  tone?: 'default' | 'on-dark';
  as?: 'p' | 'span' | 'div';
  class?: string;
}
const { tone = 'default', as: Tag = 'p', class: className = '' } = Astro.props;
---

<Tag class:list={['eyebrow', tone === 'on-dark' ? 'text-on-graphite-2' : 'text-brand-700', className]}>
  <slot />
</Tag>
