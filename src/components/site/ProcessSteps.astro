---
import { process } from '../../data/content';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  tone?: 'paper' | 'paper-2' | 'surface';
  title?: string;
  lede?: string;
  eyebrow?: string;
}
const {
  tone = 'paper-2',
  eyebrow = 'How it works',
  title = 'Three steps, no surprises',
  lede = 'The same simple route whether you need a product page fixed or a whole store built.',
} = Astro.props;
---

<Section tone={tone} aria-labelledby="process-heading">
  <SectionHeading id="process-heading" eyebrow={eyebrow} title={title} lede={lede} />
  <ol class="mt-12 grid gap-6 md:grid-cols-3">
    {process.map((step) => (
      <li class="relative rounded-lg border border-line bg-surface p-6 shadow-card sm:p-7">
        <span class="font-display text-display-md text-brand" aria-hidden="true">{step.number}</span>
        <h3 class="mt-3 text-display-sm text-ink">{step.title}</h3>
        <p class="mt-3 text-ink-2">{step.text}</p>
      </li>
    ))}
  </ol>
</Section>
