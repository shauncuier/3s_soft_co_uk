---
/** Visual breadcrumb trail. BreadcrumbList schema is emitted by Layout's @graph. */
interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface Props {
  items: BreadcrumbItem[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={['text-small text-ink-3', className]}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <li><a href="/" class="hover:text-ink">Home</a></li>
    {items.map((item, index) => {
      const last = index === items.length - 1;
      return (
        <li class="flex items-center gap-x-2">
          <span aria-hidden="true">/</span>
          {item.href && !last ? (
            <a href={item.href} class="hover:text-ink">{item.label}</a>
          ) : (
            <span class="text-ink-2" aria-current={last ? 'page' : undefined}>{item.label}</span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
