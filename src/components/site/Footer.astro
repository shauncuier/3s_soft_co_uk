---
import { site, footerNavigation, contactLinks, activeSocials, credentialLinks } from '../../data/site';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../icons/WhatsAppIcon.astro';

/** Service links mirror src/data/services.ts slugs (spec §5). */
const serviceLinks = [
  { label: 'Shopify & e-commerce stores', href: '/services/shopify/' },
  { label: 'Amazon & marketplace listings', href: '/services/amazon-marketplaces/' },
  { label: 'Automation & integrations', href: '/services/automation/' },
  { label: 'Websites for small businesses', href: '/services/web-development/' },
];
const year = new Date().getFullYear();
const hasLegal = Boolean(site.legal.companyName);
---

<footer class="mt-3 bg-graphite text-on-graphite-2">
  <Container class="py-14 sm:py-16">
    <div class="flex flex-col gap-8 border-b border-white/10 pb-12 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <a href="/" class="inline-flex rounded-sm" aria-label="3s-Soft UK home">
          <Logo variant="white" width={96} loading="lazy" />
        </a>
        <p class="mt-6 font-display text-display-md font-extrabold text-paper">{site.tagline}</p>
        <p class="mt-3 max-w-lg text-body">{site.headline}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href={contactLinks.booking} external arrow>{site.booking.label}</Button>
        {contactLinks.whatsapp && (
          <Button href={contactLinks.whatsapp} external variant="secondary-on-dark">
            <WhatsAppIcon class="size-4" />
            {site.contact.whatsappLabel}
          </Button>
        )}
      </div>
    </div>

    <div class="grid gap-10 pt-12 sm:grid-cols-2 lg:grid-cols-4">
      <nav aria-label="Footer">
        <h2 class="eyebrow text-on-graphite-2/70">Company</h2>
        <ul class="mt-4 space-y-2.5">
          {footerNavigation.map((item) => (
            <li><a href={item.href} class="text-body text-on-graphite-2 hover:text-paper">{item.label}</a></li>
          ))}
          <li><a href="/privacy/" class="text-body text-on-graphite-2 hover:text-paper">Privacy</a></li>
          <li><a href="/cookies/" class="text-body text-on-graphite-2 hover:text-paper">Cookies</a></li>
        </ul>
      </nav>

      <nav aria-label="Services">
        <h2 class="eyebrow text-on-graphite-2/70">Services</h2>
        <ul class="mt-4 space-y-2.5">
          {serviceLinks.map((item) => (
            <li><a href={item.href} class="text-body text-on-graphite-2 hover:text-paper">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow text-on-graphite-2/70">Contact</h2>
        <ul class="mt-4 space-y-2.5 text-body">
          {contactLinks.phone && <li><a href={contactLinks.phone} class="text-on-graphite-2 hover:text-paper">{site.contact.phoneDisplay}</a></li>}
          {contactLinks.email && <li><a href={contactLinks.email} class="text-on-graphite-2 hover:text-paper">{site.contact.email}</a></li>}
          <li><a href={contactLinks.booking} target="_blank" rel="noopener noreferrer" class="text-on-graphite-2 hover:text-paper">{site.booking.label}</a></li>
        </ul>
        {activeSocials.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-small" aria-label="Social profiles">
            {activeSocials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-paper">{s.label}</a></li>
            ))}
          </ul>
        )}
      </div>

      <div>
        <h2 class="eyebrow text-on-graphite-2/70">Credentials</h2>
        <ul class="mt-4 space-y-2.5 text-small">
          {credentialLinks.map((c) => (
            <li>
              <a href={c.href} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-paper">
                {c.key.startsWith('amazonSpn') ? `${c.label} — ${c.detail}` : `${c.label} (${c.detail})`}
              </a>
            </li>
          ))}
          <li>{site.reach}</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-small text-on-graphite-2/80 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.ukName}. Part of the <a href={site.mainSiteUrl} class="link-underline hover:text-paper" rel="noopener noreferrer">3s-Soft global network</a>.</p>
      {hasLegal && (
        <p>
          {site.legal.companyName}
          {site.legal.companyNumber && ` · Company no. ${site.legal.companyNumber}`}
          {site.legal.registeredAddress && ` · ${site.legal.registeredAddress}`}
        </p>
      )}
    </div>
  </Container>
</footer>
