---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import Faq from '../../components/ui/Faq.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProcessSteps from '../../components/site/ProcessSteps.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import WhatsAppIcon from '../../components/icons/WhatsAppIcon.astro';
import { services } from '../../data/services';
import { categories } from '../../data/content';
import { site, contactLinks } from '../../data/site';
import { getPublishedCaseStudy } from '../../utils/caseStudies';
import { Check } from '@lucide/astro';

export async function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const related = await getPublishedCaseStudy(service.relatedCaseStudyId);
const workSlug = categories[service.relatedCategory].workSlug;
const pageTitle = service.metaTitle.replace(/\s*\|\s*3s-Soft UK$/, '');
---

<Layout
  title={pageTitle}
  description={service.metaDescription}
  pageType="ServicePage"
  breadcrumbs={[{ label: 'Services', href: '/services/' }, { label: service.navLabel }]}
  service={{ name: service.title, description: service.metaDescription, url: service.href, slug: service.slug }}
  faqs={[...service.faqs]}
>
  <Section padding="sm">
    <Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: service.navLabel }]} class="mb-8" />
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <SectionHeading as="h1" size="xl" eyebrow="Services" title={service.h1} lede={service.lede} />
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:col-span-4 lg:justify-end">
        <Button href={contactLinks.booking} external size="lg">{site.booking.label}</Button>
        {contactLinks.whatsapp && (
          <Button href={contactLinks.whatsapp} external variant="secondary" size="lg">
            <WhatsAppIcon class="size-4" />
            {site.contact.whatsappLabel}
          </Button>
        )}
      </div>
    </div>
  </Section>

  <Section tone="paper-2" aria-labelledby="for-heading">
    <SectionHeading id="for-heading" eyebrow="Who this is for" title="You'll recognise yourself in one of these" size="md" />
    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {service.forWho.map((item, i) => (
        <li class="rounded-lg border border-line bg-surface p-6 shadow-card">
          <span class="font-display text-display-md text-brand" aria-hidden="true">0{i + 1}</span>
          <p class="mt-3 text-ink-2">{item}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section aria-labelledby="included-heading">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading id="included-heading" eyebrow="What's included" title="What we actually do" size="md" />
        <ul class="mt-8 space-y-4">
          {service.included.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-800">
                <Check class="size-3.5" aria-hidden="true" />
              </span>
              <span class="text-ink-2">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-lg border border-line bg-surface p-6 shadow-card sm:p-7 lg:sticky lg:top-24">
          <h3 class="text-display-sm text-ink">What you get</h3>
          <ul class="mt-5 space-y-3">
            {service.deliverables.map((item) => (
              <li class="flex gap-3 text-small text-ink-2">
                <span class="mt-[0.55em] size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-6 border-t border-line pt-6">
            <Button href={contactLinks.booking} external class="w-full">{site.booking.label}</Button>
            <p class="mt-3 text-center text-small text-ink-3">Free. No obligation. {site.contact.responsePromise}</p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <ProcessSteps />

  {related && (
    <Section aria-labelledby="related-heading">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <SectionHeading id="related-heading" eyebrow="Related work" title="See it done for a real brand" size="md" lede="Named client, live links, honest outcomes." />
          <div class="mt-6">
            <Button href={workSlug ? `/work/${workSlug}/` : '/work/'} variant="link">More {categories[service.relatedCategory].label.toLowerCase()} work</Button>
          </div>
        </div>
        <div class="lg:col-span-7">
          <ProjectCard project={related} headingLevel="h3" />
        </div>
      </div>
    </Section>
  )}

  <Section tone="paper-2" aria-labelledby="faq-heading">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading id="faq-heading" eyebrow="Questions" title="Things people ask us about this" size="md" />
      </div>
      <div class="lg:col-span-8">
        <Faq items={[...service.faqs]} />
      </div>
    </div>
  </Section>

  <CtaBand />
</Layout>
