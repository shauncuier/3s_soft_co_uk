---
import { whyUs } from '../../data/content';
import { site, contactLinks } from '../../data/site';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { Phone } from '@lucide/astro';
---

<Section aria-labelledby="why-heading">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <SectionHeading id="why-heading" eyebrow="Why small businesses choose us" title="Big-agency skills, small-business manners" />
      <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2">
        {whyUs.map((item) => (
          <li>
            <h3 class="text-display-sm text-ink">{item.title}</h3>
            <p class="mt-2 text-ink-2">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="lg:col-span-5">
      <div class="rounded-lg border border-line bg-surface p-7 shadow-card sm:p-8 lg:sticky lg:top-24">
        <p class="eyebrow text-ink-3">Your UK point of contact</p>
        <p class="mt-3 text-display-sm text-ink">{site.ukDirector.name}</p>
        <p class="text-small text-brand-700">{site.ukDirector.role}</p>
        <p class="mt-4 text-ink-2">{site.ukDirector.summary}</p>
        <div class="mt-6 flex flex-col gap-3">
          <Button href={contactLinks.booking} external>{site.booking.label}</Button>
          {contactLinks.phone && (
            <a href={contactLinks.phone} class="inline-flex items-center gap-2 text-body font-semibold text-ink hover:text-brand-700">
              <Phone class="size-4 text-brand" aria-hidden="true" />
              {site.contact.phoneDisplay}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</Section>
