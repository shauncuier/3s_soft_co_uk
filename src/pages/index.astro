---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechStack from '../components/TechStack.astro';
import CTA from '../components/CTA.astro';
import { getCollection } from 'astro:content';
import { capabilities, process } from '../data/content';
import { site, contactLinks } from '../data/site';
import { ArrowRight, ArrowUpRight, CheckCircle2, MessageCircle, MapPin, Globe, ShieldCheck, Zap } from '@lucide/astro';

// Fetch and sort case studies by order
const allProjects = await getCollection('caseStudies');
const featuredProjects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Layout
  title="Digital Commerce & Technology Partner"
  description="3s-Soft UK is a digital commerce and technology partner for modern UK businesses. We build Shopify storefronts, manage marketplace operations, and develop custom web platforms."
>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. Trust / Operating Thesis Section -->
  <section class="py-20 sm:py-28 bg-[#0c0e0d] border-b border-white/[0.08]" aria-labelledby="thesis-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left Statement (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-[11px] font-mono tracking-widest text-emerald-400 uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>[ 01 // OPERATING THESIS ]</span>
          </div>

          <h2 id="thesis-heading" class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter text-white leading-[1.08] text-balance">
            We turn complex digital work into practical business solutions.
          </h2>

          <p class="text-lg sm:text-xl text-neutral-300 leading-relaxed font-normal text-pretty max-w-2xl">
            From e-commerce operations and Shopify experiences to websites and custom digital systems, 3s-Soft combines technology, design and operational expertise to help businesses build and improve their digital presence.
          </p>
        </div>

        <!-- Right 3-Pillar Confidence Matrix (5 cols) -->
        <div class="lg:col-span-5 space-y-4 pt-2">
          
          <div class="p-6 rounded-2xl bg-[#111413] border border-white/[0.08] hover:border-white/[0.16] transition-colors space-y-2">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-emerald-400 font-bold">PILLAR 01</span>
              <span class="text-neutral-400">LONDON STUDIO</span>
            </div>
            <h3 class="text-base font-bold text-white tracking-tight">Direct UK Communication</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              No overseas timezone disconnect. You liaise with a dedicated UK contact for scoping, strategy, and milestone reviews.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#111413] border border-white/[0.08] hover:border-white/[0.16] transition-colors space-y-2">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-emerald-400 font-bold">PILLAR 02</span>
              <span class="text-neutral-400">ENGINEERING DEPTH</span>
            </div>
            <h3 class="text-base font-bold text-white tracking-tight">Full-Stack Capability</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              From Liquid theme development and Amazon listing health to event-driven APIs and automated inventory sync pipelines.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#111413] border border-white/[0.08] hover:border-white/[0.16] transition-colors space-y-2">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-emerald-400 font-bold">PILLAR 03</span>
              <span class="text-neutral-400">TRANSPARENCY</span>
            </div>
            <h3 class="text-base font-bold text-white tracking-tight">Zero Agency Theater</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Honest qualitative deliverables, realistic timelines, and practical software design with no speculative marketing claims.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- 3. Selected Work Section -->
  <section class="py-20 sm:py-32 bg-[#090b0a] border-b border-white/[0.08]" aria-labelledby="work-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 pb-4 border-b border-white/[0.06]">
        <SectionHeading
          id="work-heading"
          tag="[ 02 // PORTFOLIO SHOWCASE ]"
          title="Selected Work"
          subtitle="A selection of digital commerce, technology and web projects delivered by 3s-Soft for modern businesses."
        />

        <a
          href="/work/"
          class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-emerald-400 hover:text-emerald-300 transition-colors self-start sm:self-end group"
        >
          <span>View All Work &amp; Filters</span>
          <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <!-- Editorial Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        {featuredProjects.map((project, index) => (
          <ProjectCard
            project={project}
            index={index}
            variant={index === 0 ? 'featured' : 'standard'}
          />
        ))}
      </div>

    </div>
  </section>

  <!-- 4. Capabilities / What We Do Section -->
  <section class="py-20 sm:py-32 bg-[#0d100f] border-b border-white/[0.08]" aria-labelledby="capabilities-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <SectionHeading
        id="capabilities-heading"
        tag="[ 03 // CORE CAPABILITIES ]"
        title="What We Do"
        subtitle="We deliver focused, practical capability across digital commerce and technology without unnecessary overhead."
      />

      <!-- Editorial Capability Matrix -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {capabilities.map((cap, idx) => (
          <div class="p-8 rounded-3xl bg-[#111413] border border-white/[0.08] hover:border-white/[0.2] transition-colors space-y-4 flex flex-col justify-between group">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
                <span>SERVICE 0{idx + 1}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 group-hover:scale-125 transition-transform"></span>
              </div>
              <h3 class="text-xl font-bold text-white tracking-tight">
                {cap.title}
              </h3>
              <p class="text-sm text-neutral-400 leading-relaxed font-normal">
                {cap.text}
              </p>
            </div>
            
            <div class="pt-4 border-t border-white/[0.05] text-[11px] font-mono text-neutral-400 flex items-center justify-between">
              <span>EXPLORE SPECIFICS</span>
              <ArrowUpRight class="w-3.5 h-3.5 group-hover:text-emerald-400 transition-colors" />
            </div>
          </div>
        ))}

        <!-- Direct Consultation Card in Matrix -->
        <div class="p-8 rounded-3xl bg-gradient-to-br from-[#16201b] to-[#111413] border border-emerald-500/30 text-white space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-bold block">
              CUSTOM ENGINEERING?
            </span>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Have a tailored challenge?
            </h3>
            <p class="text-xs text-neutral-300 leading-relaxed">
              We frequently handle custom feeds, bespoke store features, and integration workflows tailored to unique retail setups.
            </p>
          </div>
          
          <a
            href="/contact/"
            class="inline-flex items-center justify-between py-3 px-4 rounded-2xl bg-emerald-500 text-neutral-950 font-bold text-xs hover:bg-emerald-400 hover:text-neutral-950 transition-colors"
          >
            <span>Discuss your specific setup</span>
            <ArrowUpRight class="w-4 h-4 text-neutral-950" />
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- 5. How We Work (Methodology) -->
  <section class="py-20 sm:py-32 bg-[#090b0a] border-b border-white/[0.08]" aria-labelledby="process-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <SectionHeading
        id="process-heading"
        tag="[ 04 // EXECUTION METHODOLOGY ]"
        title="How We Work"
        subtitle="A disciplined, three-step execution framework designed for business clarity, accountability, and dependable delivery."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {process.map((step) => (
          <div class="relative p-8 sm:p-10 rounded-3xl bg-[#111413] border border-white/[0.08] hover:border-white/[0.18] transition-colors space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-4xl font-extrabold font-mono text-emerald-400">
                {step.number}
              </span>
              <span class="text-xs font-mono text-neutral-400 uppercase tracking-widest">PHASE</span>
            </div>
            
            <h3 class="text-2xl font-bold text-white tracking-tight">
              {step.title}
            </h3>
            
            <p class="text-sm text-neutral-400 leading-relaxed font-normal">
              {step.text}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 6. About / UK Studio Presence Section -->
  <section class="py-20 sm:py-32 bg-[#0c0e0d] border-b border-white/[0.08]" aria-labelledby="uk-presence-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <div class="lg:col-span-7 space-y-8">
          <SectionHeading
            id="uk-presence-heading"
            tag="[ 05 // OPERATING MODEL ]"
            title="Local UK communication with global delivery capability."
            subtitle="3s-Soft is a digital technology and e-commerce company focused on building practical, scalable solutions for businesses operating online."
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
            <div class="p-6 rounded-2xl bg-[#111413] border border-white/[0.08] space-y-2">
              <div class="flex items-center gap-2 text-emerald-400">
                <MapPin class="w-4 h-4" />
                <h3 class="text-sm font-bold text-white">UK Client Connection</h3>
              </div>
              <p class="text-xs text-neutral-400 leading-relaxed">
                3s-Soft UK provides a local point of contact, seamless communication, and dedicated relationship management for UK businesses.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-[#111413] border border-white/[0.08] space-y-2">
              <div class="flex items-center gap-2 text-emerald-400">
                <Globe class="w-4 h-4" />
                <h3 class="text-sm font-bold text-white">Technology &amp; Delivery</h3>
              </div>
              <p class="text-xs text-neutral-400 leading-relaxed">
                The wider 3s-Soft engineering team provides high-capacity technology, e-commerce operations, and continuous digital delivery.
              </p>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="/about/"
              class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-emerald-400 hover:text-emerald-300 transition-colors"
            >
              <span>Learn more about our team &amp; structure</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- UK Director / Presence Showcase Card -->
        <div class="lg:col-span-5">
          <div class="p-8 sm:p-10 rounded-3xl bg-[#111413] border border-white/[0.12] space-y-8 shadow-2xl">
            <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.1] text-xs font-mono text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>UK DIRECT ENQUIRY</span>
              </div>
              <span class="text-xs font-mono text-neutral-400">LONDON, UK</span>
            </div>

            <div class="space-y-3">
              <h3 class="text-3xl font-extrabold text-white tracking-tight">
                {site.ukPresence.name}
              </h3>
              <p class="text-sm font-mono text-emerald-400">
                {site.ukPresence.role}
              </p>
              <p class="text-xs text-neutral-300 leading-relaxed pt-1">
                {site.ukPresence.summary}
              </p>
            </div>

            <div class="pt-4 border-t border-white/[0.08] space-y-3">
              {contactLinks.whatsapp && (
                <a
                  href={contactLinks.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-2.5 py-3.5 px-4 rounded-xl bg-emerald-500 text-neutral-950 font-bold text-xs hover:bg-emerald-400 hover:text-neutral-950 transition-colors shadow-md"
                >
                  <MessageCircle class="w-4 h-4 fill-current text-neutral-950" />
                  <span>Connect directly on WhatsApp</span>
                </a>
              )}

              {contactLinks.email && (
                <a
                  href={contactLinks.email}
                  class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white font-mono text-xs hover:bg-white/[0.08] transition-colors"
                >
                  <span>{site.contact.email}</span>
                </a>
              )}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 7. Technology & Platforms Section -->
  <TechStack />

  <!-- 8. Final Conversion CTA -->
  <CTA />
</Layout>
