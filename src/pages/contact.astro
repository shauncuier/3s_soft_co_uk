---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProcessSteps from '../components/site/ProcessSteps.astro';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import { site, contactLinks } from '../data/site';
import { CalendarCheck, Phone, Mail, Check } from '@lucide/astro';

const callCovers = [
  'What you sell, where you sell it and what is not working.',
  'Whether we can help, and roughly what it would involve.',
  'What we would need from you to write a fixed-price plan.',
];
const haveReady = [
  'Links to your store, website or Amazon listings.',
  'Anything you have already tried.',
  'A rough idea of what "better" would look like for you.',
];
---

<Layout
  title="Contact 3s-Soft UK — Book a 15-minute Call"
  description="Book a free 15-minute call, message us on WhatsApp, or phone the UK team. We reply within one UK business day."
  pageType="ContactPage"
  breadcrumbs={[{ label: 'Contact' }]}
  hideWhatsApp
>
  <Section padding="sm">
    <Breadcrumbs items={[{ label: 'Contact' }]} class="mb-8" />
    <SectionHeading
      as="h1"
      size="xl"
      eyebrow="Contact"
      title="Tell us what's not working."
      accent="not working."
      lede="Pick whichever route suits you. There's nothing to pay for the call or the plan, and no obligation afterwards."
    />
  </Section>

  <Section padding="sm" aria-label="Ways to get in touch">
    <div class="grid gap-6 lg:grid-cols-12">
      <div class="relative overflow-hidden rounded-xl border border-brand-100 bg-brand-50 p-7 shadow-card sm:p-9 lg:col-span-7"><div class="rings text-brand" style="--rings-x: 100%; --rings-y: 100%;" aria-hidden="true"></div>
        <div class="flex items-center gap-3">
          <span class="inline-flex size-11 items-center justify-center rounded-md bg-brand text-white"><CalendarCheck class="size-5" aria-hidden="true" /></span>
          <h2 class="text-display-sm text-ink">{site.booking.label}</h2>
        </div>
        <p class="mt-4 text-ink-2">Fifteen minutes on a video or phone call, at a time you choose. Most people leave knowing whether we can help and what the next step is.</p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <div>
            <h3 class="eyebrow text-ink-3">What the call covers</h3>
            <ul class="mt-3 space-y-2 text-small text-ink-2">
              {callCovers.map((i) => <li class="flex gap-2"><Check class="mt-0.5 size-4 shrink-0 text-brand" aria-hidden="true" />{i}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="eyebrow text-ink-3">Useful to have ready</h3>
            <ul class="mt-3 space-y-2 text-small text-ink-2">
              {haveReady.map((i) => <li class="flex gap-2"><Check class="mt-0.5 size-4 shrink-0 text-brand" aria-hidden="true" />{i}</li>)}
            </ul>
          </div>
        </div>
        <div class="relative mt-8">
          <Button href={contactLinks.booking} external size="lg" arrow>Choose a time</Button>
        </div>
      </div>

      <div class="grid gap-6 lg:col-span-5">
        {contactLinks.whatsapp && (
          <div class="rounded-lg border border-line bg-surface p-6 shadow-card">
            <div class="flex items-center gap-3">
              <span class="inline-flex size-11 items-center justify-center rounded-md bg-brand-100 text-brand-800"><WhatsAppIcon class="size-5" /></span>
              <h2 class="text-display-sm text-ink">WhatsApp</h2>
            </div>
            <p class="mt-3 text-small text-ink-2">Quickest for a question or to send a link. Opens a chat with our UK team.</p>
            <div class="mt-5"><Button href={contactLinks.whatsapp} external variant="secondary">{site.contact.whatsappLabel}</Button></div>
          </div>
        )}
        {contactLinks.phone && (
          <div class="rounded-lg border border-line bg-surface p-6 shadow-card">
            <div class="flex items-center gap-3">
              <span class="inline-flex size-11 items-center justify-center rounded-md bg-brand-100 text-brand-800"><Phone class="size-5" aria-hidden="true" /></span>
              <h2 class="text-display-sm text-ink">Phone</h2>
            </div>
            <p class="mt-3 text-small text-ink-2">UK business hours, Monday to Friday. Ask for {site.ukDirector.name.split(' ')[0]}.</p>
            <a href={contactLinks.phone} class="mt-4 inline-block text-lede font-semibold text-ink hover:text-brand-700">{site.contact.phoneDisplay}</a>
          </div>
        )}
        {contactLinks.email && (
          <div class="rounded-lg border border-line bg-surface p-6 shadow-card">
            <div class="flex items-center gap-3">
              <span class="inline-flex size-11 items-center justify-center rounded-md bg-brand-100 text-brand-800"><Mail class="size-5" aria-hidden="true" /></span>
              <h2 class="text-display-sm text-ink">Email</h2>
            </div>
            <p class="mt-3 text-small text-ink-2">Best for briefs, documents and anything you want in writing. {site.contact.responsePromise}</p>
            <a href={contactLinks.email} class="mt-4 inline-block text-lede font-semibold text-ink hover:text-brand-700">{site.contact.email}</a>
          </div>
        )}
      </div>
    </div>
  </Section>

  <ProcessSteps eyebrow="What happens next" title="After you get in touch" lede="No sales process, just three steps." />
</Layout>
