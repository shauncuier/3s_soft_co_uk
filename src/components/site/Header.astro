---
import { navigation, contactLinks, site } from '../../data/site';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import MobileNav from './MobileNav.astro';
import { Menu } from '@lucide/astro';

interface Props {
  currentPath?: string;
}
const { currentPath = Astro.url.pathname } = Astro.props;
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="fixed inset-x-0 top-3 z-40 px-3 sm:top-4 sm:px-5">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 rounded-full border border-line bg-paper/90 py-1.5 pl-4 pr-1.5 shadow-card backdrop-blur-md sm:pl-5">
    <a href="/" class="inline-flex shrink-0 items-center rounded-sm" aria-label="3s-Soft UK home">
      <Logo width={64} />
    </a>

    <nav class="hidden md:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        {navigation.map((item) => {
          const active = isCurrent(item.href);
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'inline-flex rounded-full px-3.5 py-2 text-small font-semibold transition-colors duration-180',
                  active ? 'bg-ink text-paper' : 'text-ink-2 hover:bg-paper-2 hover:text-ink',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden md:block">
        <Button href={contactLinks.booking} external size="sm" arrow>{site.booking.label}</Button>
      </div>
      <button
        type="button"
        id="mobile-nav-open"
        class="inline-flex size-10 items-center justify-center rounded-full bg-ink text-paper md:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <Menu class="size-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <MobileNav currentPath={currentPath} />
</header>
