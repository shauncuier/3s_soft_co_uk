---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, contactLinks } from '../data/site';
import { Image } from 'astro:assets';
import storefrontImg from '../assets/projects/shopify-storefront.jpg';
import automationImg from '../assets/projects/automation.jpg';
import { MapPin, Globe, CheckCircle2, MessageCircle, Mail, Phone, ArrowUpRight } from '@lucide/astro';
---

<Layout
  title="About Us — Technology With a Practical Mindset"
  description="Learn about 3s-Soft UK, our operating model combining local UK client communication with global technology delivery capability."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-20 sm:pt-14 sm:pb-32 space-y-20 sm:space-y-32">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[{ label: 'About' }]} />

    <!-- Hero Header -->
    <div class="max-w-5xl space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-[11px] font-mono tracking-widest text-emerald-400 uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>[ 01 // ABOUT 3S-SOFT UK ]</span>
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tighter text-white text-balance leading-[1.05]">
        Technology With a Practical Mindset.
      </h1>

      <p class="text-xl sm:text-2xl text-neutral-300 leading-relaxed max-w-3xl font-normal text-pretty">
        3s-Soft is a digital technology and e-commerce company focused on building practical, scalable solutions for businesses operating online.
      </p>
    </div>

    <!-- Operating Model Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center pt-10 border-t border-white/[0.08]" aria-labelledby="model-heading">
      <div class="lg:col-span-6 space-y-8">
        <div class="space-y-4">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-400">
            [ 02 // OPERATING STRUCTURE ]
          </span>

          <h2 id="model-heading" class="text-3xl sm:text-5xl font-extrabold tracking-tighter text-white text-balance leading-[1.08]">
            Local communication with global delivery capability.
          </h2>
        </div>

        <p class="text-base sm:text-lg text-neutral-300 leading-relaxed font-normal">
          UK businesses require reliable day-to-day communication, quick response times, and an understanding of British commerce standards. At the same time, scaling digital commerce and technology operations requires disciplined engineering resources.
        </p>

        <p class="text-base text-neutral-400 leading-relaxed">
          Our structure delivers both: a direct, local relationship right here in the UK backed by the delivery strength of our wider technology and digital operations teams.
        </p>

        <div class="space-y-4 pt-2">
          <div class="p-6 rounded-2xl bg-[#111413] border border-white/[0.08] space-y-2">
            <div class="flex items-center gap-2 text-emerald-400">
              <MapPin class="w-4 h-4" />
              <h3 class="text-sm font-bold text-white font-mono uppercase tracking-wide">UK Client Connection</h3>
            </div>
            <p class="text-xs text-neutral-400 leading-relaxed">
              3s-Soft UK provides a local point of contact, strategic alignment, and dedicated account support in the UK timezone.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#111413] border border-white/[0.08] space-y-2">
            <div class="flex items-center gap-2 text-emerald-400">
              <Globe class="w-4 h-4" />
              <h3 class="text-sm font-bold text-white font-mono uppercase tracking-wide">Technology &amp; Delivery</h3>
            </div>
            <p class="text-xs text-neutral-400 leading-relaxed">
              The wider 3s-Soft engineering team provides high-capacity technology, e-commerce operations, and continuous digital delivery.
            </p>
          </div>
        </div>
      </div>

      <!-- Visual Showcase of Work & Systems -->
      <div class="lg:col-span-6 space-y-4">
        <div class="rounded-3xl overflow-hidden bg-black border border-white/[0.12] shadow-2xl">
          <Image
            src={storefrontImg}
            alt="E-commerce digital delivery example"
            width={800}
            height={520}
            class="w-full h-auto object-cover"
          />
        </div>
        <div class="p-4 rounded-2xl bg-[#111413] border border-white/[0.08] text-xs font-mono text-neutral-400 flex items-center justify-between">
          <span class="text-neutral-200">Engineering Rigor &amp; Practicality</span>
          <span>Shopify · Marketplaces · Web Platforms</span>
        </div>
      </div>
    </section>

    <!-- UK Presence / Leadership Profile Section -->
    <section id="uk-presence" class="pt-12 border-t border-white/[0.08] space-y-10" aria-labelledby="leadership-heading">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-400">
          [ 03 // UK POINT OF CONTACT ]
        </span>
        <h2 id="leadership-heading" class="text-3xl sm:text-5xl font-extrabold tracking-tighter text-white">
          Your Point of Contact in the UK
        </h2>
        <p class="text-base text-neutral-300">
          Available directly for exploratory calls, technical consultations, and scoping discussions.
        </p>
      </div>

      <div class="max-w-2xl rounded-3xl bg-[#111413] border border-white/[0.12] p-8 sm:p-12 space-y-8 shadow-2xl">
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-1">
            <span class="inline-flex items-center gap-1.5 text-xs font-mono px-3 py-1 rounded-full bg-white/[0.04] text-neutral-300 border border-white/[0.08]">
              <MapPin class="w-3.5 h-3.5 text-emerald-400" />
              <span>UNITED KINGDOM</span>
            </span>
            <h3 class="text-3xl font-extrabold text-white tracking-tight pt-3">
              {site.ukPresence.name}
            </h3>
            <p class="text-sm font-mono text-emerald-400">
              {site.ukPresence.role}
            </p>
          </div>
        </div>

        <p class="text-sm text-neutral-300 leading-relaxed font-normal">
          {site.ukPresence.summary}
        </p>

        <div class="pt-6 border-t border-white/[0.08] flex flex-wrap items-center gap-4">
          {contactLinks.whatsapp && (
            <a
              href={contactLinks.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full font-bold text-xs bg-emerald-500 text-neutral-950 hover:bg-emerald-400 hover:text-neutral-950 transition-colors shadow-md"
            >
              <MessageCircle class="w-4 h-4 fill-current text-neutral-950" />
              <span>WhatsApp Direct</span>
            </a>
          )}

          {contactLinks.email && (
            <a
              href={contactLinks.email}
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full font-mono text-xs bg-white/[0.04] text-white border border-white/[0.1] hover:bg-white/[0.08] transition-colors"
            >
              <Mail class="w-4 h-4 text-neutral-400" />
              <span>{site.contact.email}</span>
            </a>
          )}

          {contactLinks.phone && (
            <a
              href={contactLinks.phone}
              class="inline-flex items-center gap-2 text-xs font-mono text-neutral-400 hover:text-white transition-colors"
            >
              <Phone class="w-4 h-4" />
              <span>{site.contact.phoneDisplay}</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- Global Connection Link -->
    <section class="p-8 sm:p-12 rounded-3xl bg-[#111413] border border-white/[0.08] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="space-y-2 max-w-xl">
        <h3 class="text-xl font-bold text-white tracking-tight">3s-Soft Global Network</h3>
        <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
          3s-Soft UK is part of 3s-Soft, delivering full-stack development, marketplace services, and digital solutions globally.
        </p>
      </div>
      <a
        href={site.mainSiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-mono font-bold bg-white text-neutral-950 hover:bg-neutral-100 hover:text-neutral-950 transition-colors shrink-0"
      >
        <span>Visit 3s-soft.com</span>
        <ArrowUpRight class="w-3.5 h-3.5 text-neutral-950" />
      </a>
    </section>

  </div>

  <CTA
    title="Let's discuss how we can work together."
    subtitle="Reach out via WhatsApp or email to schedule an introductory conversation."
  />
</Layout>
