---
/** Floating WhatsApp shortcut, phones only (spec §4). Desktop has the header CTA. */
import { contactLinks, site } from '../data/site';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---

{contactLinks.whatsapp && (
  <a
    href={contactLinks.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-5 right-5 z-30 inline-flex size-14 items-center justify-center rounded-full bg-brand text-white shadow-card-hover transition-colors duration-180 hover:bg-brand-700 md:hidden print:hidden"
    aria-label={site.contact.whatsappLabel}
  >
    <WhatsAppIcon class="size-6" />
  </a>
)}
