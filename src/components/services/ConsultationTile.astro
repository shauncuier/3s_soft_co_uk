---
import { consultationTile } from '../../data/content';
import { site, contactLinks } from '../../data/site';
import Button from '../ui/Button.astro';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: Heading = 'h3' } = Astro.props;
---

<div class="flex h-full flex-col rounded-lg border border-brand-100 bg-brand-50 p-6 shadow-card sm:p-7">
  <Heading class="text-display-sm text-ink">{consultationTile.title}</Heading>
  <p class="mt-3 text-ink-2">{consultationTile.text}</p>
  <div class="mt-auto pt-6">
    <Button href={contactLinks.booking} external>{site.booking.label}</Button>
  </div>
</div>
