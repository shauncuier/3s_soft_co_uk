---
import { site, contactLinks } from '../data/site';
import { ArrowUpRight, MessageCircle, Mail } from '@lucide/astro';

interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = "Let's build something useful.",
  subtitle = "Tell us what you're working on. We'll get back to you to discuss the next step without pressure or sales jargon.",
  class: className = '',
} = Astro.props;
---

<section class:list={['relative overflow-hidden my-16 sm:my-24', className]} aria-labelledby="cta-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl bg-[#141716] text-white p-8 sm:p-12 lg:p-16 border border-[#272d2a] overflow-hidden">
      
      <!-- Subtle background ambient grid -->
      <div class="absolute inset-0 brand-grid-pattern-dark opacity-30 pointer-events-none" aria-hidden="true"></div>
      
      <!-- Subtle accent glow -->
      <div class="absolute -right-24 -top-24 w-96 h-96 bg-brand-green/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/15 text-xs font-semibold text-neutral-300">
          <span class="w-2 h-2 rounded-full bg-brand-green"></span>
          <span>{site.ukName} · Client Partnership</span>
        </div>

        <h2 id="cta-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white text-balance">
          {title}
        </h2>

        <p class="text-base sm:text-lg text-neutral-300 leading-relaxed max-w-2xl text-pretty">
          {subtitle}
        </p>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="/contact/"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full font-semibold text-sm bg-white text-text-primary hover:bg-neutral-100 transition-all duration-200 shadow-sm"
          >
            <span>Start a Conversation</span>
            <ArrowUpRight class="w-4 h-4" />
          </a>

          {contactLinks.whatsapp && (
            <a
              href={contactLinks.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full font-semibold text-sm bg-brand-green text-white hover:bg-brand-green-hover transition-all duration-200 shadow-sm"
            >
              <MessageCircle class="w-4 h-4 shrink-0" />
              <span>WhatsApp Us</span>
            </a>
          )}

          {contactLinks.email && (
            <a
              href={contactLinks.email}
              class="inline-flex items-center gap-2 px-5 py-3.5 text-sm text-neutral-300 hover:text-white transition-colors"
            >
              <Mail class="w-4 h-4 shrink-0" />
              <span>{site.contact.email}</span>
            </a>
          )}
        </div>
      </div>

    </div>
  </div>
</section>
