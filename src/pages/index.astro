---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Ticker from '../components/site/Ticker.astro';
import Stats from '../components/home/Stats.astro';
import Comparison from '../components/home/Comparison.astro';
import ServicesPanel from '../components/home/ServicesPanel.astro';
import FeaturedWork from '../components/home/FeaturedWork.astro';
import ProcessSteps from '../components/site/ProcessSteps.astro';
import WhyUs from '../components/home/WhyUs.astro';
import Testimonials from '../components/site/Testimonials.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import CtaBand from '../components/site/CtaBand.astro';
