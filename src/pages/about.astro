---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PersonCard from '../components/site/PersonCard.astro';
import CredentialList from '../components/site/CredentialList.astro';
import ProcessSteps from '../components/site/ProcessSteps.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Stats from '../components/home/Stats.astro';
import Testimonials from '../components/site/Testimonials.astro';
import { site } from '../data/site';
import { whyUs } from '../data/content';
---

<Layout
  title="About 3s-Soft UK — One Team for Stores & Listings"
  description="3s-Soft UK is the UK-facing team of 3s-Soft: Shopify stores, Amazon listings, automation and websites for small businesses, with a UK point of contact."
  pageType="AboutPage"
  breadcrumbs={[{ label: 'About' }]}
>
  <Section padding="sm">
    <Breadcrumbs items={[{ label: 'About' }]} class="mb-8" />
    <SectionHeading
      as="h1"
      size="xl"
      eyebrow="About"
      title="A small team that builds, fixes and runs online sales for small businesses."
      accent="small businesses."
      lede={site.positioning}
    />
  </Section>

  <Section padding="sm" aria-labelledby="story-heading">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="story-heading" class="font-display text-display-md text-ink">Why we exist</h2>
      </div>
      <div class="space-y-5 text-body text-ink-2 lg:col-span-7">
        <p>
          Most small businesses that sell online end up with three suppliers: someone for the website, someone for the Shopify store and someone else again for Amazon or eBay. None of them talks to the others, and the owner becomes the project manager.
        </p>
        <p>
          3s-Soft was set up to be one team for all of it. We design and build stores and websites, we write and design marketplace listings, and we build the automation that keeps stock and prices in step between them. The same people do the work from the first call to the day you go live, and after.
        </p>
        <p>
          3s-Soft UK is the UK-facing part of the <a href={site.mainSiteUrl} class="link-underline text-ink" rel="noopener noreferrer">wider 3s-Soft team</a>. You get a UK point of contact and UK business hours, backed by developers who have shipped stores, plugins and marketplace work for clients in more than thirty countries.
        </p>
      </div>
    </div>
  </Section>

  <Stats />

  <Section aria-labelledby="people-heading">
    <SectionHeading id="people-heading" eyebrow="People" title="Who you'll be talking to." accent="talking to." size="md" />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <PersonCard name={site.ukDirector.name} role={site.ukDirector.role} summary={site.ukDirector.summary} />
      <PersonCard name={site.founder.name} role={site.founder.role} summary="Leads the engineering and marketplace work across the team." url={site.founder.url} />
    </div>
  </Section>

  <Section id="credentials" aria-labelledby="credentials-heading">
    <SectionHeading id="credentials-heading" eyebrow="Credentials" title="Things you can check for yourself." accent="check for yourself." size="md" lede="Every claim below links to its source. We don't use the words 'partner' or 'endorsed' for Amazon, because a listing is a listing." />
    <CredentialList class="mt-10" />
  </Section>

  <Section tone="paper-2" aria-labelledby="why-heading">
    <SectionHeading id="why-heading" eyebrow="How we work" title="What small businesses tell us they value." accent="they value." size="md" />
    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {whyUs.map((item) => (
        <li class="rounded-xl border border-line bg-surface p-6 shadow-card hover-lift" data-reveal>
          <h3 class="text-display-sm text-ink">{item.title}</h3>
          <p class="mt-3 text-ink-2">{item.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <ProcessSteps tone="paper" />
  <Testimonials />
  <CtaBand />
</Layout>
