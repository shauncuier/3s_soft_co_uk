---
import { site, contactLinks } from '../../data/site';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import HeroMosaic from './HeroMosaic.astro';
import WhatsAppIcon from '../icons/WhatsAppIcon.astro';
import { BadgeCheck } from '@lucide/astro';

const accent = 'your marketplace listings';
const idx = site.headline.indexOf(accent);
const parts = idx >= 0 ? [site.headline.slice(0, idx), accent, site.headline.slice(idx + accent.length)] : [site.headline, '', ''];
---

<section class="relative overflow-hidden pb-10 pt-8 sm:pt-14" aria-labelledby="hero-heading">
  <div class="rings text-brand" style="--rings-x: 50%; --rings-y: 0%;" aria-hidden="true"></div>
  <Container class="relative">
    <div class="mx-auto max-w-4xl text-center">
      <Eyebrow chip class="mx-auto">{site.tagline}</Eyebrow>
      <h1 id="hero-heading" class="mt-6 font-display text-display-xl text-ink">
        {parts[0]}<span class="text-brand">{parts[1]}</span>{parts[2]}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lede text-ink-2">
        3s-Soft UK helps small businesses and e-commerce sellers build, fix and grow their online sales, without juggling three different agencies.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={contactLinks.booking} external size="lg" arrow>{site.booking.label}</Button>
        {contactLinks.whatsapp && (
          <Button href={contactLinks.whatsapp} external variant="secondary" size="lg">
            <WhatsAppIcon class="size-4" />
            {site.contact.whatsappLabel}
          </Button>
        )}
      </div>
      <p class="mt-5 inline-flex items-center gap-2 text-small text-ink-3">
        <BadgeCheck class="size-4 text-brand" aria-hidden="true" />
        Free call · fixed-price plan · {site.contact.responsePromise}
      </p>
    </div>
  </Container>

  <div class="mt-12 sm:mt-16">
    <HeroMosaic />
  </div>
</section>
