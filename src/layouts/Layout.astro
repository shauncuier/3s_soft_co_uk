---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';
import { buildSchemaGraph, type BreadcrumbItem, type CaseStudySchemaInput } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  breadcrumbs?: BreadcrumbItem[];
  caseStudy?: CaseStudySchemaInput;
  /** Optional FAQ pairs rendered on the page; emitted as FAQPage schema when the schema builder supports it. */
  faqs?: { q: string; a: string }[];
  /** Optional service descriptor for /services/* pages; emitted as Service schema when supported. */
  service?: { name: string; description: string; url: string; slug: string };
  /** Hide the floating WhatsApp button (e.g. on the contact page). */
  hideWhatsApp?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og-default.png',
  canonicalUrl,
  noindex = false,
  pageType = 'WebPage',
  breadcrumbs,
  caseStudy,
  faqs,
  service,
  hideWhatsApp = false,
} = Astro.props;

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const formattedTitle = isHome
  ? `E-commerce, Shopify & Amazon Support for UK Small Businesses | ${site.ukName}`
  : title
    ? `${title} | ${site.ukName}`
    : `${site.ukName} | ${site.positioning}`;

const cleanPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = canonicalUrl || new URL(cleanPath, site.url).href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, site.url).href;

const schemaGraph = buildSchemaGraph({
  pathname: cleanPath,
  pageTitle: formattedTitle,
  pageDescription: description,
  pageType,
  breadcrumbs,
  caseStudy,
  ogImageUrl: fullOgImage,
  ...(faqs && faqs.length ? { faqs } : {}),
  ...(service ? { service } : {}),
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{formattedTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="3s-Soft UK" />
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Fonts: self-hosted, preloaded, with generated fallback metrics -->
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-instrument-serif" preload={[{ style: 'normal' }]} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.ukName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.ukName} — ${site.positioning}`} />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f7f6f2" />

    <meta name="google-site-verification" content="BCYfUnolXJvi3-Bgfaw3jm23PI6Ffi9jUGl5j-be0Lk" />

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KFB5J47T55"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KFB5J47T55');
    </script>

    <!-- Structured data (single @graph) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-paper focus:font-semibold"
    >
      Skip to main content
    </a>

    <Header currentPath={Astro.url.pathname} />

    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <Footer />
    {!hideWhatsApp && <WhatsAppButton />}
  </body>
</html>
