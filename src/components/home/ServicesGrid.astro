---
import { capabilities } from '../../data/content';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceCard from '../services/ServiceCard.astro';
import ConsultationTile from '../services/ConsultationTile.astro';
---

<Section aria-labelledby="services-heading">
  <SectionHeading id="services-heading" eyebrow="What we do" title="Four things, done properly, by one team" lede="Pick the one that sounds like your problem. If it's more than one, that's exactly what we're for." />
  <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {capabilities.map((cap) => (
      <ServiceCard title={cap.title} forWho={cap.forWho} bullets={cap.bullets} href={cap.href} />
    ))}
    <ConsultationTile />
  </div>
</Section>
