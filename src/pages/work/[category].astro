---
import Layout from '../../layouts/Layout.astro';
import WorkListing from '../../components/work/WorkListing.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import { workCategoryPages } from '../../data/content';
import { getCaseStudiesByCategory } from '../../utils/caseStudies';

export async function getStaticPaths() {
  return Promise.all(
    workCategoryPages.map(async (cat) => ({
      params: { category: cat.slug },
      props: { categoryMeta: cat, projects: await getCaseStudiesByCategory(cat.category) },
    })),
  );
}

const { categoryMeta, projects } = Astro.props;
---

<Layout
  title={categoryMeta.title}
  description={categoryMeta.description}
  pageType="CollectionPage"
  breadcrumbs={[{ label: 'Work', href: '/work/' }, { label: categoryMeta.title }]}
>
  <WorkListing
    projects={projects}
    eyebrow="Our work"
    heading={categoryMeta.heading}
    lede={categoryMeta.description}
    current={categoryMeta.slug}
    breadcrumbs={[{ label: 'Work', href: '/work/' }, { label: categoryMeta.title }]}
  />
  <CtaBand />
</Layout>
