---
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import type { CollectionEntry } from 'astro:content';
import { ExternalLink } from '@lucide/astro';

interface Props {
  project: CollectionEntry<'caseStudies'>;
}

const { project } = Astro.props;
const { data, id } = project;
---

<section class="pt-8 pb-16 sm:pt-14 sm:pb-20 border-b border-white/[0.08] bg-[#0c0e0d]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { label: 'Work', href: '/work/' },
        { label: 'Case Studies', href: '/case-studies/' },
        { label: data.title },
      ]}
    />

    <!-- Eyebrow & Category -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-mono font-bold tracking-wider uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>{data.categoryLabel}</span>
        </span>
        {data.placeholder && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono text-neutral-400 bg-white/[0.05] border border-white/[0.1]">
            DEMO BRIEF
          </span>
        )}
      </div>

      {data.liveUrl && (
        <a
          href={data.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-emerald-400 text-neutral-950 hover:bg-emerald-300 transition-colors shadow-lg shadow-emerald-500/20"
        >
          <span>Visit Live Website</span>
          <ExternalLink class="w-3.5 h-3.5 stroke-[2.5]" />
        </a>
      )}
    </div>

    <!-- Title & Tagline -->
    <div class="max-w-5xl space-y-4">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tighter text-white text-balance leading-[1.05]">
        {data.title}
      </h1>
      <p class="text-xl sm:text-2xl text-neutral-300 leading-relaxed font-normal text-pretty max-w-3xl">
        {data.tagline}
      </p>
    </div>

    <!-- Metadata Grid Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-6 pt-8 pb-4 border-t border-white/[0.08] text-sm">
      <div class="space-y-1">
        <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-400">Client / Sector</p>
        <p class="font-semibold text-white">{data.client}</p>
      </div>

      <div class="space-y-1">
        <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-400">Industry</p>
        <p class="font-semibold text-white">{data.industry}</p>
      </div>

      <div class="space-y-1">
        <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-400">Year Delivered</p>
        <p class="font-semibold text-white">{data.year}</p>
      </div>

      <div class="space-y-1">
        <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-400">Primary Platform</p>
        <p class="font-semibold text-emerald-400 font-mono">{data.platforms[0] || 'Web'}</p>
      </div>

      {data.market && (
        <div class="space-y-1">
          <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-400">Target Market</p>
          <p class="font-semibold text-neutral-200">{data.market}</p>
        </div>
      )}

      {data.builtBy && (
        <div class="space-y-1">
          <p class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-400">Engineered By</p>
          <p class="font-semibold text-emerald-300">{data.builtBy}</p>
        </div>
      )}
    </div>

    <!-- Main Hero Visual Frame -->
    <div class="rounded-3xl overflow-hidden bg-black border border-white/[0.12] shadow-2xl">
      <Image
        src={data.heroImage}
        alt={data.heroAlt}
        width={1400}
        height={850}
        class="w-full h-auto object-cover max-h-[680px]"
        loading="eager"
      />
    </div>

  </div>
</section>
