---
import { site, contactLinks } from '../data/site';
import HeroVisual from './HeroVisual.astro';
import { ArrowRight, ArrowUpRight, MessageCircle } from '@lucide/astro';
---

<section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 lg:pt-24 lg:pb-36 overflow-hidden border-b border-white/[0.08] bg-[#090b0a]">
  
  <!-- Subtle Architectural Grid Background -->
  <div class="absolute inset-0 agency-grid-pattern opacity-40 pointer-events-none" aria-hidden="true"></div>
  
  <!-- Subtle Radial Gradient Center Spot -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-500/[0.05] rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Monospace Status Chip -->
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/[0.06] text-xs font-mono text-neutral-400">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-neutral-300 font-semibold tracking-wider uppercase">{site.ukName}</span>
        <span class="text-neutral-600">//</span>
        <span class="text-neutral-400">LONDON STUDIO</span>
      </div>
      <div class="hidden sm:flex items-center gap-4 text-[11px] text-neutral-400">
        <span>EST. 3S-SOFT GLOBAL NETWORK</span>
      </div>
    </div>

    <!-- Editorial Hero Header Block -->
    <div class="max-w-5xl space-y-8">
      
      <!-- Headline with Tight Tracking -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tighter text-white leading-[1.02] text-balance">
        Digital Commerce &amp; Technology, <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-emerald-200 to-white">Built for Business.</span>
      </h1>

      <!-- Supporting Copy -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline pt-2">
        <p class="md:col-span-8 text-lg sm:text-xl lg:text-2xl text-neutral-300 leading-relaxed font-normal text-pretty">
          We create digital experiences, e-commerce solutions and technology systems that help businesses operate and grow online.
        </p>
        
        <div class="md:col-span-4 flex flex-col space-y-2 text-xs font-mono text-neutral-400 border-l border-white/[0.1] pl-4">
          <span class="text-neutral-200 font-semibold">DELIVERY SCOPE:</span>
          <span>• Shopify &amp; Custom Storefronts</span>
          <span>• Multi-Channel Amazon &amp; eBay</span>
          <span>• Product Information Data (PIM)</span>
          <span>• APIs, Automation &amp; Web Platforms</span>
        </div>
      </div>

      <!-- Action Buttons Dock -->
      <div class="pt-4 flex flex-wrap items-center gap-3 sm:gap-4">
        <a
          href="/work/"
          class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full font-bold text-sm bg-white text-neutral-950 hover:bg-neutral-100 hover:text-neutral-950 transition-all duration-200 hover:scale-[1.02] shadow-lg shadow-white/5"
        >
          <span>View Our Work</span>
          <ArrowRight class="w-4 h-4 text-neutral-950" />
        </a>

        {contactLinks.whatsapp && (
          <a
            href={contactLinks.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-6 py-4 rounded-full font-semibold text-sm bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 hover:bg-emerald-500 hover:text-neutral-950 transition-all duration-200 group"
            aria-label="Direct WhatsApp consultation"
          >
            <MessageCircle class="w-4 h-4 fill-current text-emerald-400 group-hover:text-neutral-950 transition-colors" />
            <span>Chat on WhatsApp</span>
          </a>
        )}

        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-6 py-4 rounded-full font-semibold text-sm bg-white/[0.05] border border-white/[0.12] text-white hover:bg-white/[0.12] hover:text-white transition-all duration-200 group"
        >
          <span>Let's Talk</span>
          <ArrowUpRight class="w-4 h-4 text-neutral-400 group-hover:text-white transition-colors" />
        </a>
      </div>

    </div>

    <!-- Flagship Visual Showcase Frame -->
    <HeroVisual />

  </div>
</section>
