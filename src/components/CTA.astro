---
import { site, contactLinks } from '../data/site';
import { ArrowUpRight, MessageCircle, Mail } from '@lucide/astro';

interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = "Let's build something useful.",
  subtitle = "Tell us what you're working on. We'll get back to you to discuss the next step without pressure or sales jargon.",
  class: className = '',
} = Astro.props;
---

<section class:list={['relative overflow-hidden py-20 sm:py-28', className]} aria-labelledby="cta-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl bg-gradient-to-b from-[#141816] to-[#0c0e0d] text-white p-8 sm:p-14 lg:p-20 border border-white/[0.12] overflow-hidden shadow-2xl">
      
      <!-- Architectural Pattern Background -->
      <div class="absolute inset-0 agency-grid-pattern opacity-30 pointer-events-none" aria-hidden="true"></div>
      
      <!-- Ambient Emerald Glow -->
      <div class="absolute -right-20 -top-20 w-96 h-96 bg-emerald-500/[0.12] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 max-w-3xl space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.06] border border-white/[0.12] text-xs font-mono text-emerald-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{site.ukName} // DIRECT CONSULTATION</span>
        </div>

        <h2 id="cta-heading" class="text-4xl sm:text-6xl font-extrabold tracking-tighter text-white text-balance leading-[1.05]">
          {title}
        </h2>

        <p class="text-base sm:text-xl text-neutral-300 leading-relaxed font-normal text-pretty max-w-2xl">
          {subtitle}
        </p>

        <!-- Conversion Action Buttons -->
        <div class="pt-6 flex flex-wrap items-center gap-4">
          <a
            href="/contact/"
            class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full font-bold text-sm bg-white text-neutral-950 hover:bg-neutral-200 transition-all duration-200 hover:scale-[1.02] shadow-lg shadow-white/5"
          >
            <span>Start a Conversation</span>
            <ArrowUpRight class="w-4 h-4 text-neutral-900" />
          </a>

          {contactLinks.whatsapp && (
            <a
              href={contactLinks.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-7 py-4 rounded-full font-semibold text-sm bg-emerald-500 text-neutral-950 hover:bg-emerald-400 transition-all duration-200 shadow-lg shadow-emerald-500/10"
            >
              <MessageCircle class="w-4 h-4 fill-current text-neutral-950" />
              <span>WhatsApp Us Directly</span>
            </a>
          )}

          {contactLinks.email && (
            <a
              href={contactLinks.email}
              class="inline-flex items-center gap-2 px-5 py-4 text-xs font-mono text-neutral-400 hover:text-white transition-colors"
            >
              <Mail class="w-4 h-4" />
              <span>{site.contact.email}</span>
            </a>
          )}
        </div>

      </div>

    </div>
  </div>
</section>
