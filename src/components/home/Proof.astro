---
import { site } from '../../data/site';
import Container from '../ui/Container.astro';
import { BadgeCheck, Star, Globe2, MapPin, ArrowUpRight } from '@lucide/astro';

const icons = { amazonSpn: BadgeCheck, reviews: Star, reach: Globe2, ukContact: MapPin } as const;
---

<section class="border-y border-line bg-paper-2" aria-label="Why you can trust us">
  <Container>
    <ul class="grid gap-x-8 gap-y-4 py-6 sm:grid-cols-2 lg:grid-cols-4">
      {site.proof.map((item) => {
        const Icon = icons[item.key as keyof typeof icons] ?? BadgeCheck;
        return (
          <li>
            <a
              href={item.href}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="group inline-flex items-start gap-2.5 text-small font-medium text-ink-2 hover:text-ink"
            >
              <Icon class="mt-0.5 size-4 shrink-0 text-brand" aria-hidden="true" />
              <span>
                {item.label}
                {item.external && <ArrowUpRight class="ml-1 inline size-3.5 align-text-top text-ink-3 group-hover:text-ink" aria-hidden="true" />}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </Container>
</section>
