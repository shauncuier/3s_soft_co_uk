---
import { Image } from 'astro:assets';
import storefrontImg from '../assets/projects/shopify-storefront.jpg';
import marketplaceImg from '../assets/projects/marketplace-operations.jpg';
import mobileImg from '../assets/projects/mobile-commerce.jpg';
import productDataImg from '../assets/projects/product-data.jpg';
import { ArrowUpRight } from '@lucide/astro';
---

<div class="relative w-full max-w-5xl mx-auto mt-12 lg:mt-16 select-none" aria-hidden="true">
  
  <!-- Subtle ambient glow in background -->
  <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-3/4 h-64 bg-brand-green/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Layered Showcase Frame -->
  <div class="relative z-10 grid grid-cols-12 gap-4 lg:gap-6 items-center">
    
    <!-- Primary Hero Card (Main Storefront Browser - 8 cols) -->
    <div class="col-span-12 lg:col-span-8 rounded-2xl bg-white border border-surface-border shadow-2xl overflow-hidden transition-all duration-300 hover:border-neutral-300">
      
      <!-- Minimal Browser Chrome Bar -->
      <div class="flex items-center justify-between px-4 py-3 bg-neutral-50/80 border-b border-surface-border">
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-400/80"></span>
          <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-surface-border text-[11px] font-mono text-text-muted">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
          <span>storefront.production/uk</span>
        </div>
        <div class="text-[11px] font-semibold text-text-muted">
          Shopify Plus
        </div>
      </div>

      <!-- Main Visual Preview -->
      <div class="relative aspect-[16/10] bg-neutral-100 overflow-hidden">
        <Image
          src={storefrontImg}
          alt="Digital commerce storefront interface preview"
          width={1000}
          height={625}
          class="w-full h-full object-cover object-top"
          loading="eager"
        />

        <!-- Subtle overlay badge -->
        <div class="absolute bottom-4 left-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/95 backdrop-blur-md border border-surface-border shadow-sm text-xs font-semibold text-text-primary">
          <span class="w-2 h-2 rounded-full bg-brand-green"></span>
          <span>Digital Commerce Experience</span>
        </div>
      </div>
    </div>

    <!-- Secondary Stacked Visuals (4 cols on desktop) -->
    <div class="col-span-12 lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-4 lg:gap-6">
      
      <!-- Marketplace Operations Card -->
      <div class="flex-1 rounded-xl bg-white border border-surface-border shadow-lg overflow-hidden group hover:border-neutral-300 transition-colors">
        <div class="px-3.5 py-2.5 bg-neutral-50/80 border-b border-surface-border flex items-center justify-between text-xs">
          <span class="font-semibold text-text-primary">Multi-Channel Sync</span>
          <span class="text-[10px] uppercase font-mono tracking-wider px-1.5 py-0.5 rounded bg-brand-green-light text-brand-green font-semibold">Active</span>
        </div>
        <div class="aspect-[16/9] bg-neutral-100 overflow-hidden">
          <Image
            src={marketplaceImg}
            alt="Multi-channel marketplace listing management interface preview"
            width={500}
            height={281}
            class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
            loading="eager"
          />
        </div>
      </div>

      <!-- Product Data & PIM Fragment -->
      <div class="flex-1 rounded-xl bg-white border border-surface-border shadow-lg overflow-hidden group hover:border-neutral-300 transition-colors">
        <div class="px-3.5 py-2.5 bg-neutral-50/80 border-b border-surface-border flex items-center justify-between text-xs">
          <span class="font-semibold text-text-primary">Catalogue &amp; PIM</span>
          <span class="text-[10px] text-text-muted">Structured Data</span>
        </div>
        <div class="aspect-[16/9] bg-neutral-100 overflow-hidden">
          <Image
            src={productDataImg}
            alt="Structured product data management interface preview"
            width={500}
            height={281}
            class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      </div>

    </div>

  </div>

  <!-- Bottom Accent Ribbon / Supporting Proof Indicator -->
  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 px-4 py-3 rounded-xl bg-white/70 backdrop-blur-sm border border-surface-border text-xs text-text-secondary">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-brand-green"></span>
      <span class="font-medium text-text-primary">Demonstrated Capability:</span>
      <span>Shopify · Amazon UK · eBay · Web Architecture · Automation</span>
    </div>
    <a
      href="/work/"
      class="inline-flex items-center gap-1 font-semibold text-text-primary hover:text-brand-green transition-colors"
    >
      <span>Browse All Selected Projects</span>
      <ArrowUpRight class="w-3.5 h-3.5" />
    </a>
  </div>

</div>
