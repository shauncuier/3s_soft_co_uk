---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, contactLinks } from '../data/site';
import { Image } from 'astro:assets';
import storefrontImg from '../assets/projects/shopify-storefront.jpg';
import automationImg from '../assets/projects/automation.jpg';
import { MapPin, Globe, CheckCircle2, MessageCircle, Mail, Phone, ArrowUpRight } from '@lucide/astro';
---

<Layout
  title="About Us — Technology With a Practical Mindset"
  description="Learn about 3s-Soft UK, our operating model combining local UK client communication with global technology delivery capability."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16 sm:pt-12 sm:pb-24 space-y-16 sm:space-y-24">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[{ label: 'About' }]} />

    <!-- Hero Header -->
    <div class="max-w-4xl space-y-6">
      <div class="flex items-center gap-2">
        <span class="w-4 h-0.5 bg-brand-green"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-brand-green">
          About 3s-Soft UK
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-text-primary text-balance">
        Technology With a Practical Mindset.
      </h1>

      <p class="text-lg sm:text-2xl text-text-secondary leading-relaxed text-pretty font-normal">
        3s-Soft is a digital technology and e-commerce company focused on building practical, scalable solutions for businesses operating online.
      </p>
    </div>

    <!-- Operating Model Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center pt-8 border-t border-surface-border" aria-labelledby="model-heading">
      <div class="lg:col-span-6 space-y-6">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-green">
          Our Structure
        </span>

        <h2 id="model-heading" class="text-3xl sm:text-4xl font-bold tracking-tight text-text-primary text-balance">
          Local communication with global delivery capability.
        </h2>

        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          UK businesses require reliable day-to-day communication, quick response times, and an understanding of British commerce standards. At the same time, scaling digital commerce and technology operations requires disciplined engineering resources.
        </p>

        <p class="text-base text-text-secondary leading-relaxed">
          Our structure delivers both: a direct, local relationship right here in the UK backed by the delivery strength of our wider technology and digital operations teams.
        </p>

        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-brand-green-light text-brand-green flex items-center justify-center shrink-0 mt-0.5">
              <CheckCircle2 class="w-3.5 h-3.5" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-text-primary">UK Client Connection</h3>
              <p class="text-xs text-text-secondary mt-0.5">
                3s-Soft UK provides a local point of contact, strategic alignment, and ongoing account support in your timezone.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-brand-green-light text-brand-green flex items-center justify-center shrink-0 mt-0.5">
              <CheckCircle2 class="w-3.5 h-3.5" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-text-primary">Technology &amp; Delivery</h3>
              <p class="text-xs text-text-secondary mt-0.5">
                The wider 3s-Soft team provides specialized technology, marketplace operations, and full-stack software delivery.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Visual Showcase of Work & Systems -->
      <div class="lg:col-span-6 space-y-4">
        <div class="rounded-2xl overflow-hidden bg-neutral-100 border border-surface-border shadow-lg">
          <Image
            src={storefrontImg}
            alt="E-commerce digital delivery example"
            width={700}
            height={460}
            class="w-full h-auto object-cover"
          />
        </div>
        <div class="p-4 rounded-xl bg-white border border-surface-border text-xs text-text-secondary flex items-center justify-between">
          <span class="font-medium text-text-primary">Built on proven engineering discipline</span>
          <span class="text-text-muted">Shopify · Web Platforms · Data APIs</span>
        </div>
      </div>
    </section>

    <!-- UK Presence / Leadership Profile Section -->
    <section id="uk-presence" class="pt-12 border-t border-surface-border space-y-8" aria-labelledby="leadership-heading">
      <div class="max-w-2xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-green">
          UK Presence
        </span>
        <h2 id="leadership-heading" class="text-3xl sm:text-4xl font-bold tracking-tight text-text-primary">
          Your Point of Contact in the UK
        </h2>
        <p class="text-sm sm:text-base text-text-secondary">
          Available directly for exploratory calls, technical consultations, and scoping discussions.
        </p>
      </div>

      <div class="max-w-2xl rounded-3xl bg-white border border-surface-border p-8 sm:p-10 space-y-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-1">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded bg-surface-bg text-text-secondary border border-surface-border">
              <MapPin class="w-3 h-3 text-brand-green" />
              <span>United Kingdom</span>
            </span>
            <h3 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight pt-2">
              {site.ukPresence.name}
            </h3>
            <p class="text-sm font-semibold text-brand-green">
              {site.ukPresence.role}
            </p>
          </div>
        </div>

        <p class="text-sm text-text-secondary leading-relaxed">
          {site.ukPresence.summary}
        </p>

        <div class="pt-4 border-t border-surface-border flex flex-wrap items-center gap-4">
          {contactLinks.whatsapp && (
            <a
              href={contactLinks.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-semibold text-xs bg-brand-green text-white hover:bg-brand-green-hover transition-colors shadow-xs"
            >
              <MessageCircle class="w-4 h-4" />
              <span>WhatsApp Direct</span>
            </a>
          )}

          {contactLinks.email && (
            <a
              href={contactLinks.email}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-semibold text-xs bg-white text-text-primary border border-surface-border hover:bg-surface-bg transition-colors"
            >
              <Mail class="w-3.5 h-3.5 text-text-secondary" />
              <span>{site.contact.email}</span>
            </a>
          )}

          {contactLinks.phone && (
            <a
              href={contactLinks.phone}
              class="inline-flex items-center gap-2 text-xs font-semibold text-text-secondary hover:text-text-primary transition-colors"
            >
              <Phone class="w-3.5 h-3.5" />
              <span>{site.contact.phoneDisplay}</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- Global Connection Link -->
    <section class="p-8 rounded-3xl bg-surface-bg border border-surface-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="space-y-1 max-w-xl">
        <h3 class="text-lg font-bold text-text-primary">3s-Soft Global Network</h3>
        <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
          3s-Soft UK is part of 3s-Soft, delivering full-stack development, marketplace services, and digital solutions globally.
        </p>
      </div>
      <a
        href={site.mainSiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-semibold bg-white border border-surface-border text-text-primary hover:border-neutral-300 transition-colors shadow-2xs shrink-0"
      >
        <span>Visit 3s-soft.com</span>
        <ArrowUpRight class="w-3.5 h-3.5 text-text-muted" />
      </a>
    </section>

  </div>

  <CTA
    title="Let's discuss how we can work together."
    subtitle="Reach out via WhatsApp or email to schedule an introductory conversation."
  />
</Layout>
