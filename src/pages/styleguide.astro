---
/** Dev-only visual check of the design system. noindex; removed before launch. */
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Logo from '../components/ui/Logo.astro';
import Faq from '../components/ui/Faq.astro';
import { ArrowRight } from '@lucide/astro';

const swatches = [
  ['paper', 'bg-paper'], ['paper-2', 'bg-paper-2'], ['surface', 'bg-surface'], ['line', 'bg-line'],
  ['ink', 'bg-ink'], ['ink-2', 'bg-ink-2'], ['ink-3', 'bg-ink-3'],
  ['brand', 'bg-brand'], ['brand-700', 'bg-brand-700'], ['brand-100', 'bg-brand-100'], ['brand-50', 'bg-brand-50'],
  ['graphite', 'bg-graphite'], ['graphite-2', 'bg-graphite-2'],
];
const faqs = [
  { q: 'Do you work with very small businesses?', a: 'Yes. Most of our clients are owner-run shops and brands with one to twenty people.' },
  { q: 'How do you quote?', a: 'A fixed price after a short call, in writing, with what is and is not included.' },
];
---

<Layout title="Styleguide" noindex>
  <Section padding="sm">
    <SectionHeading eyebrow="Design system" title="Styleguide" lede="Every primitive on one page. If something looks wrong here, it is wrong everywhere." as="h1" size="xl" />
  </Section>

  <Section tone="surface" padding="sm" aria-label="Colour">
    <h2 class="text-display-md mb-6">Colour</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-7">
      {swatches.map(([name, cls]) => (
        <div>
          <div class:list={['h-16 rounded-md border border-line', cls]}></div>
          <p class="mt-2 text-small text-ink-2">{name}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section padding="sm" aria-label="Type">
    <h2 class="text-display-md mb-6">Type</h2>
    <div class="space-y-6">
      <p class="font-display text-display-xl">Display XL — One UK team for your store.</p>
      <p class="font-display text-display-lg">Display LG — Built for business, <em>plainly</em>.</p>
      <p class="font-display text-display-md">Display MD — What we do</p>
      <p class="text-display-sm font-bold">Display SM (Manrope 700) — Card title</p>
      <p class="text-lede text-ink-2">Lede — We help small businesses and e-commerce sellers build, fix and grow their online sales.</p>
      <p class="text-body">Body 17px — Say what we did and what happened. Never invent numbers. Explain Amazon and Shopify terms the first time we use them.</p>
      <p class="text-small text-ink-3">Small 15px — Captions and metadata.</p>
      <Eyebrow>Label 13px — Eyebrow</Eyebrow>
    </div>
  </Section>

  <Section tone="paper-2" padding="sm" aria-label="Buttons">
    <h2 class="text-display-md mb-6">Buttons</h2>
    <div class="flex flex-wrap items-center gap-4">
      <Button href="#">Book a 15-minute call <ArrowRight class="size-4" aria-hidden="true" /></Button>
      <Button href="#" variant="secondary">Chat on WhatsApp</Button>
      <Button href="#" variant="ghost">Ghost</Button>
      <Button href="#" variant="link">Text link</Button>
      <Button href="#" size="sm">Small</Button>
      <Button href="#" size="lg">Large</Button>
      <Button type="button" disabled>Disabled</Button>
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <Tag>Shopify</Tag><Tag>Amazon Seller Central</Tag><Tag tone="brand">Amazon · A+ Content</Tag>
    </div>
  </Section>

  <Section padding="sm" aria-label="Cards">
    <h2 class="text-display-md mb-6">Cards</h2>
    <div class="grid gap-6 md:grid-cols-3">
      <Card interactive>
        <Eyebrow class="mb-3">Service</Eyebrow>
        <h3 class="text-display-sm">Shopify & e-commerce stores</h3>
        <p class="mt-3 text-ink-2">For brands that need a store that sells: new builds, theme fixes, speed, migrations.</p>
      </Card>
      <Card tone="paper-2">
        <h3 class="text-display-sm">Paper-2 card</h3>
        <p class="mt-3 text-ink-2">Used for quieter supporting content.</p>
      </Card>
      <Card tone="brand-50">
        <h3 class="text-display-sm">Brand-50 card</h3>
        <p class="mt-3 text-ink-2">Used once per page for the consultation prompt.</p>
      </Card>
    </div>
  </Section>

  <Section padding="sm" aria-label="FAQ">
    <h2 class="text-display-md mb-6">FAQ</h2>
    <Faq items={faqs} />
  </Section>

  <Section padding="sm" aria-label="Logo">
    <h2 class="text-display-md mb-6">Logo</h2>
    <div class="flex flex-wrap items-center gap-10">
      <Logo width={104} />
      <Logo width={160} />
    </div>
  </Section>

  <Section tone="graphite" padding="sm" aria-label="On dark">
    <SectionHeading tone="on-dark" eyebrow="Final CTA band" title="Tell us what's not working." lede="We'll tell you what it takes to fix it, in plain English, with a fixed price." />
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="#" variant="primary-on-dark">Book a 15-minute call</Button>
      <Button href="#" variant="secondary-on-dark">Chat on WhatsApp</Button>
    </div>
    <div class="mt-10"><Logo variant="white" width={120} /></div>
    <div class="mt-8"><Faq items={faqs} tone="on-dark" /></div>
  </Section>
</Layout>
