---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTA from '../../components/CTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { workCategoryPages, type CategoryKey } from '../../data/content';

export async function getStaticPaths() {
  const allProjects = await getCollection('caseStudies');

  return workCategoryPages.map((cat) => {
    const filteredProjects = allProjects
      .filter((project) => project.data.categories.includes(cat.category))
      .sort((a, b) => a.data.order - b.data.order);

    return {
      params: { category: cat.slug },
      props: {
        categoryMeta: cat,
        projects: filteredProjects,
      },
    };
  });
}

const { categoryMeta, projects } = Astro.props;
---

<Layout
  title={categoryMeta.title}
  description={categoryMeta.description}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16 sm:pt-12 sm:pb-24 space-y-12">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { label: 'Work', href: '/work/' },
        { label: categoryMeta.title },
      ]}
    />

    <!-- Header -->
    <div class="max-w-3xl space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-4 h-0.5 bg-brand-green"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-brand-green">
          Specialised Capability
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-text-primary">
        {categoryMeta.heading}
      </h1>
      <p class="text-lg sm:text-xl text-text-secondary leading-relaxed">
        {categoryMeta.description}
      </p>
    </div>

    <!-- Related Work Links Pill Navigation -->
    <div class="flex flex-wrap items-center gap-2 pt-2 border-b border-surface-border pb-6">
      <a
        href="/work/"
        class="px-4 py-2 rounded-full text-xs font-semibold bg-white text-text-secondary border border-surface-border hover:border-neutral-300 hover:text-text-primary transition-colors"
      >
        All Work
      </a>
      {workCategoryPages.map((cat) => {
        const isCurrent = cat.slug === categoryMeta.slug;
        return (
          <a
            href={`/work/${cat.slug}/`}
            class:list={[
              'px-4 py-2 rounded-full text-xs font-semibold transition-colors',
              isCurrent
                ? 'bg-text-primary text-white shadow-xs'
                : 'bg-white text-text-secondary border border-surface-border hover:border-neutral-300 hover:text-text-primary',
            ]}
          >
            {cat.title}
          </a>
        );
      })}
    </div>

    <!-- Project List -->
    {projects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {projects.map((project, index) => (
          <ProjectCard
            project={project}
            variant={index === 0 ? 'featured' : 'standard'}
          />
        ))}
      </div>
    ) : (
      <div class="py-16 text-center rounded-2xl bg-white border border-surface-border p-8 space-y-3">
        <p class="text-base font-semibold text-text-primary">No case studies listed under this category yet.</p>
        <p class="text-xs text-text-muted">Explore our full portfolio or get in touch directly to discuss custom requirements.</p>
        <div class="pt-2">
          <a href="/work/" class="text-xs font-semibold text-brand-green hover:underline">
            View all work →
          </a>
        </div>
      </div>
    )}

  </div>

  <CTA
    title={`Need a specialist for ${categoryMeta.title}?`}
    subtitle="We collaborate with UK businesses on bespoke digital commerce, marketplace feeds, and technical web projects."
  />
</Layout>
