---
/**
 * Button — the only button/link-button style on the site.
 * Renders <a> when `href` is given, otherwise <button>.
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost' | 'link' | 'primary-on-dark' | 'secondary-on-dark';
type Size = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  variant?: Variant;
  size?: Size;
  type?: 'button' | 'submit' | 'reset';
  external?: boolean;
  disabled?: boolean;
  class?: string;
  /** Icon placement when an icon is passed through the default slot after the label. */
  iconPosition?: 'start' | 'end';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  external = false,
  class: className = '',
  iconPosition = 'end',
  disabled = false,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-md font-semibold leading-none whitespace-nowrap transition-colors duration-180 ease-soft select-none disabled:opacity-50 disabled:pointer-events-none';

const variants: Record<Variant, string> = {
  primary: 'bg-brand text-white hover:bg-brand-700 active:bg-brand-800',
  secondary: 'bg-surface text-ink border border-line-strong hover:border-ink hover:bg-paper-2',
  ghost: 'text-ink hover:bg-paper-2',
  link: 'text-brand-700 hover:text-brand-800 underline underline-offset-[0.2em] decoration-brand-700/40 hover:decoration-brand-800 px-0 py-0 rounded-none',
  'primary-on-dark': 'bg-on-graphite text-graphite hover:bg-white',
  'secondary-on-dark': 'text-on-graphite border border-white/25 hover:border-white/60 hover:bg-white/10',
};

const sizes: Record<Size, string> = {
  sm: 'text-small px-4 py-2.5',
  md: 'text-body px-5 py-3',
  lg: 'text-body px-6 py-3.5 sm:px-7 sm:py-4',
};

const classes = [base, variants[variant], variant === 'link' ? '' : sizes[size], iconPosition === 'start' && 'flex-row-reverse', className];

const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a href={href} class:list={classes} {...externalAttrs} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} disabled={disabled || undefined} {...(rest as any)}>
    <slot />
  </button>
)}
