---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Proof from '../components/home/Proof.astro';
import ServicesGrid from '../components/home/ServicesGrid.astro';
import FeaturedWork from '../components/home/FeaturedWork.astro';
import ProcessSteps from '../components/site/ProcessSteps.astro';
import WhyUs from '../components/home/WhyUs.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { homeFaqs } from '../data/faq';
import { site } from '../data/site';
---

<Layout description={site.description} faqs={[...homeFaqs]}>
  <Hero />
  <Proof />
  <ServicesGrid />
  <FeaturedWork />
  <ProcessSteps tone="paper" />
  <WhyUs />
  <HomeFaq />
  <CtaBand />
</Layout>
