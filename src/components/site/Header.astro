---
import { navigation, contactLinks, site } from '../../data/site';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import MobileNav from './MobileNav.astro';
import { Menu } from '@lucide/astro';

interface Props {
  currentPath?: string;
}
const { currentPath = Astro.url.pathname } = Astro.props;
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <Container class="flex h-18 items-center justify-between gap-6">
    <a href="/" class="inline-flex shrink-0 items-center rounded-sm" aria-label="3s-Soft UK home">
      <Logo width={84} class="sm:hidden" />
      <Logo width={96} class="hidden sm:block" />
      <span class="sr-only">3s-Soft UK</span>
    </a>

    <nav class="hidden md:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        {navigation.map((item) => {
          const active = isCurrent(item.href);
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'inline-flex rounded-md px-3.5 py-2 text-body font-medium transition-colors duration-180',
                  active ? 'text-ink underline decoration-brand decoration-2 underline-offset-8' : 'text-ink-2 hover:text-ink hover:bg-paper-2',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden md:block">
        <Button href={contactLinks.booking} external size="sm">{site.booking.label}</Button>
      </div>
      <button
        type="button"
        id="mobile-nav-open"
        class="inline-flex size-11 items-center justify-center rounded-md border border-line bg-surface text-ink hover:bg-paper-2 md:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <Menu class="size-5" aria-hidden="true" />
      </button>
    </div>
  </Container>

  <MobileNav currentPath={currentPath} />
</header>
