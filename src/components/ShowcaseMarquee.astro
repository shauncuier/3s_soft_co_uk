---
/**
 * ShowcaseMarquee.astro
 *
 * Forge Studio-style dual-row infinite marquee showcase with hover-pause,
 * subtle glass card borders, and high-impact monospace text ribbon.
 */
import { Image } from 'astro:assets';
import tailwaterImg from '../assets/projects/tailwater-supply.jpg';
import shopifyImg from '../assets/projects/shopify-storefront.jpg';
import marketplaceImg from '../assets/projects/marketplace-operations.jpg';
import dropshipzoneImg from '../assets/projects/dropshipzone-sync.jpg';
import mobileImg from '../assets/projects/mobile-commerce.jpg';
import productDataImg from '../assets/projects/product-data.jpg';
import automationImg from '../assets/projects/automation.jpg';
import corporateImg from '../assets/projects/corporate-website.jpg';
import { ArrowUpRight, ArrowRight } from '@lucide/astro';

const rowOneProjects = [
  {
    title: 'Tailwater Supply Co.',
    category: 'E-Commerce & Amazon Seller',
    image: tailwaterImg,
    href: '/case-studies/tailwater-supply-co/',
    metric: 'Shopify Storefront',
  },
  {
    title: 'Nordic Homeware Direct',
    category: 'Shopify Theme Engineering',
    image: shopifyImg,
    href: '/case-studies/nordic-homeware-shopify/',
    metric: 'Sub-1.2s LCP',
  },
  {
    title: 'Multichannel Marketplace Ops',
    category: 'Amazon & Walmart Syndication',
    image: marketplaceImg,
    href: '/case-studies/multichannel-marketplace-ops/',
    metric: 'Unified Inventory',
  },
  {
    title: 'Dropshipzone Price & Stock Sync',
    category: 'Custom WooCommerce Plugin',
    image: dropshipzoneImg,
    href: '/case-studies/dropshipzone-price-stock-sync/',
    metric: '10,000+ SKU Sync',
  },
];

const rowTwoProjects = [
  {
    title: 'Apparel Mobile Commerce',
    category: 'Mobile-First Storefront',
    image: mobileImg,
    href: '/case-studies/apparel-mobile-commerce-experience/',
    metric: '68% Mobile Share',
  },
  {
    title: 'Retail Catalogue Data System',
    category: 'PIM & Structured Feeds',
    image: productDataImg,
    href: '/case-studies/retail-catalogue-data-system/',
    metric: 'Feed Normalisation',
  },
  {
    title: 'Order & Inventory Automation',
    category: 'Custom API Middleware',
    image: automationImg,
    href: '/case-studies/order-inventory-sync-automation/',
    metric: 'Zero Manual Export',
  },
  {
    title: 'Industrial Engineering Platform',
    category: 'B2B Technical Platform',
    image: corporateImg,
    href: '/case-studies/industrial-engineering-platform/',
    metric: 'RFQs & Catalogs',
  },
];

const tickerItems = [
  'SHOPIFY PLUS',
  'MULTI-CHANNEL MARKETPLACES',
  'CUSTOM WOOCOMMERCE PLUGINS',
  'HIGH-PERFORMANCE ASTRO',
  'PRODUCT DATA & PIM',
  'INVENTORY AUTOMATION',
  'UK COMMERCE CONSULTATION',
  'GLOBAL DELIVERY',
];
---

<section class="relative py-16 sm:py-24 bg-[#070908] border-b border-white/[0.08] overflow-hidden" aria-label="Selected Production Work">
  
  <!-- Subtle Header Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 sm:mb-14">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6" data-reveal>
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-mono tracking-widest text-emerald-400 uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>[ 02 // SELECTED PRODUCTION RELEASES ]</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
          Real Systems. Measurable Outcomes.
        </h2>
        <p class="text-sm sm:text-base text-neutral-400 max-w-2xl font-normal">
          Explore production storefronts, automation engines, and marketplace architectures deployed for modern brands.
        </p>
      </div>

      <a
        href="/work/"
        class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-emerald-400 hover:text-emerald-300 transition-colors uppercase tracking-wider group shrink-0"
      >
        <span>View Complete Index (6 Studies)</span>
        <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>

  <!-- Marquee Display Deck with Center Overlay Float -->
  <div class="relative marquee-container space-y-5 overflow-hidden">
    
    <!-- Left & Right Gradient Fade Edges -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-32 bg-gradient-to-r from-[#070908] to-transparent z-20"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-32 bg-gradient-to-l from-[#070908] to-transparent z-20"></div>

    <!-- ========================================================== -->
    <!-- ROW 1: Gliding Left                                       -->
    <!-- ========================================================== -->
    <div class="overflow-hidden" style="--marquee-speed: 40s;">
      <div class="animate-marquee-left flex gap-5">
        
        <!-- Track 1 -->
        <div class="flex gap-5 shrink-0">
          {rowOneProjects.map((project) => (
            <a
              href={project.href}
              class="group relative w-[280px] sm:w-[360px] lg:w-[420px] rounded-2xl sm:rounded-3xl bg-[#111413] border border-white/[0.08] hover:border-emerald-500/50 p-3 sm:p-4 transition-all duration-300 shadow-xl flex flex-col gap-3 shrink-0 block"
            >
              <div class="relative aspect-[16/10] rounded-xl sm:rounded-2xl overflow-hidden bg-black border border-white/[0.06]">
                <Image
                  src={project.image}
                  alt={project.title}
                  width={500}
                  height={312}
                  class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/[0.1] text-[10px] font-mono text-emerald-400 font-semibold">
                  {project.metric}
                </span>
              </div>
              <div class="flex items-center justify-between px-1">
                <div class="space-y-0.5">
                  <h3 class="text-sm font-bold text-white group-hover:text-emerald-300 transition-colors">
                    {project.title}
                  </h3>
                  <p class="text-[11px] font-mono text-neutral-400">
                    {project.category}
                  </p>
                </div>
                <div class="w-7 h-7 rounded-full bg-white/[0.05] border border-white/[0.1] flex items-center justify-center text-neutral-400 group-hover:text-white group-hover:bg-emerald-500 group-hover:border-emerald-500 transition-all">
                  <ArrowUpRight class="w-3.5 h-3.5" />
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Track 1 Clone for Seamless Loop -->
        <div class="flex gap-5 shrink-0" aria-hidden="true">
          {rowOneProjects.map((project) => (
            <div class="group relative w-[280px] sm:w-[360px] lg:w-[420px] rounded-2xl sm:rounded-3xl bg-[#111413] border border-white/[0.08] p-3 sm:p-4 shadow-xl flex flex-col gap-3 shrink-0">
              <div class="relative aspect-[16/10] rounded-xl sm:rounded-2xl overflow-hidden bg-black border border-white/[0.06]">
                <Image
                  src={project.image}
                  alt=""
                  width={500}
                  height={312}
                  class="w-full h-full object-cover object-top"
                  loading="lazy"
                />
                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/[0.1] text-[10px] font-mono text-emerald-400 font-semibold">
                  {project.metric}
                </span>
              </div>
              <div class="flex items-center justify-between px-1">
                <div class="space-y-0.5">
                  <span class="text-sm font-bold text-white block">
                    {project.title}
                  </span>
                  <span class="text-[11px] font-mono text-neutral-400 block">
                    {project.category}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>

    <!-- ========================================================== -->
    <!-- ROW 2: Gliding Right (Opposite direction)                 -->
    <!-- ========================================================== -->
    <div class="overflow-hidden" style="--marquee-speed: 45s;">
      <div class="animate-marquee-right flex gap-5">
        
        <!-- Track 2 -->
        <div class="flex gap-5 shrink-0">
          {rowTwoProjects.map((project) => (
            <a
              href={project.href}
              class="group relative w-[280px] sm:w-[360px] lg:w-[420px] rounded-2xl sm:rounded-3xl bg-[#111413] border border-white/[0.08] hover:border-emerald-500/50 p-3 sm:p-4 transition-all duration-300 shadow-xl flex flex-col gap-3 shrink-0 block"
            >
              <div class="relative aspect-[16/10] rounded-xl sm:rounded-2xl overflow-hidden bg-black border border-white/[0.06]">
                <Image
                  src={project.image}
                  alt={project.title}
                  width={500}
                  height={312}
                  class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/[0.1] text-[10px] font-mono text-emerald-400 font-semibold">
                  {project.metric}
                </span>
              </div>
              <div class="flex items-center justify-between px-1">
                <div class="space-y-0.5">
                  <h3 class="text-sm font-bold text-white group-hover:text-emerald-300 transition-colors">
                    {project.title}
                  </h3>
                  <p class="text-[11px] font-mono text-neutral-400">
                    {project.category}
                  </p>
                </div>
                <div class="w-7 h-7 rounded-full bg-white/[0.05] border border-white/[0.1] flex items-center justify-center text-neutral-400 group-hover:text-white group-hover:bg-emerald-500 group-hover:border-emerald-500 transition-all">
                  <ArrowUpRight class="w-3.5 h-3.5" />
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Track 2 Clone for Seamless Loop -->
        <div class="flex gap-5 shrink-0" aria-hidden="true">
          {rowTwoProjects.map((project) => (
            <div class="group relative w-[280px] sm:w-[360px] lg:w-[420px] rounded-2xl sm:rounded-3xl bg-[#111413] border border-white/[0.08] p-3 sm:p-4 shadow-xl flex flex-col gap-3 shrink-0">
              <div class="relative aspect-[16/10] rounded-xl sm:rounded-2xl overflow-hidden bg-black border border-white/[0.06]">
                <Image
                  src={project.image}
                  alt=""
                  width={500}
                  height={312}
                  class="w-full h-full object-cover object-top"
                  loading="lazy"
                />
                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/[0.1] text-[10px] font-mono text-emerald-400 font-semibold">
                  {project.metric}
                </span>
              </div>
              <div class="flex items-center justify-between px-1">
                <div class="space-y-0.5">
                  <span class="text-sm font-bold text-white block">
                    {project.title}
                  </span>
                  <span class="text-[11px] font-mono text-neutral-400 block">
                    {project.category}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>

    <!-- ========================================================== -->
    <!-- CENTER CALLOUT BADGE (Forge Studio Floating Orb Feature)  -->
    <!-- ========================================================== -->
    <div class="pointer-events-none absolute inset-0 z-30 flex items-center justify-center">
      <div class="pointer-events-auto p-2 rounded-full bg-gradient-to-b from-white/20 to-emerald-500/20 backdrop-blur-2xl shadow-2xl border border-white/[0.16] hover:scale-105 transition-transform duration-300">
        <a
          href="/work/"
          class="flex flex-col items-center justify-center text-center px-6 py-5 rounded-full bg-[#111413]/95 border border-white/[0.1] text-white space-y-1.5 shadow-inner"
        >
          <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-emerald-400">
            ENGINEERED IN LONDON
          </span>
          <span class="text-base sm:text-lg font-bold tracking-tight text-white flex items-center gap-1.5">
            <span>Explore All Work</span>
            <ArrowRight class="w-4 h-4 text-emerald-400" />
          </span>
          <span class="text-[10px] font-mono text-neutral-400">
            Shopify · Marketplaces · Custom APIs
          </span>
        </a>
      </div>
    </div>

  </div>

  <!-- ============================================================ -->
  <!-- HIGH-CONTRAST MONOSPACE TICKER RIBBON (Forge Studio style)   -->
  <!-- ============================================================ -->
  <div class="mt-14 sm:mt-20 border-y border-emerald-500/30 bg-emerald-500/[0.08] py-3.5 overflow-hidden" aria-hidden="true">
    <div class="flex w-max animate-marquee-left" style="--marquee-speed: 25s;">
      <div class="flex gap-8 items-center shrink-0 pr-8">
        {tickerItems.map((item) => (
          <span class="font-mono text-xs sm:text-sm font-bold tracking-wider text-emerald-300 uppercase whitespace-nowrap flex items-center gap-3">
            <span>{item}</span>
            <span class="text-emerald-500/50">⟶</span>
          </span>
        ))}
      </div>
      <div class="flex gap-8 items-center shrink-0 pr-8" aria-hidden="true">
        {tickerItems.map((item) => (
          <span class="font-mono text-xs sm:text-sm font-bold tracking-wider text-emerald-300 uppercase whitespace-nowrap flex items-center gap-3">
            <span>{item}</span>
            <span class="text-emerald-500/50">⟶</span>
          </span>
        ))}
      </div>
    </div>
  </div>

</section>
