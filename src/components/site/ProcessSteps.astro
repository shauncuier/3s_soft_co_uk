---
import { process } from '../../data/content';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  tone?: 'paper' | 'paper-2' | 'surface';
  title?: string;
  accent?: string;
  lede?: string;
  eyebrow?: string;
}
const {
  tone = 'paper',
  eyebrow = 'How it works',
  title = 'Three steps. No surprises.',
  accent = 'No surprises.',
  lede = 'The same simple route whether you need a product page fixed or a whole store built.',
} = Astro.props;
---

<Section tone={tone} aria-labelledby="process-heading">
  <SectionHeading id="process-heading" eyebrow={eyebrow} title={title} accent={accent} lede={lede} align="center" />
  <ol class="mt-12 grid gap-5 md:grid-cols-3">
    {process.map((step, i) => (
      <li class="relative flex flex-col rounded-xl border border-line bg-surface p-7 shadow-card sm:p-8" data-reveal data-reveal-delay={String(i)}>
        <span class="font-display text-stat font-extrabold text-brand" aria-hidden="true">{step.number}</span>
        <h3 class="mt-6 text-display-sm text-ink">{step.title}</h3>
        <p class="mt-3 text-ink-2">{step.text}</p>
      </li>
    ))}
  </ol>
</Section>
