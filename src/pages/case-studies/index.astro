---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTA from '../../components/CTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/content';

const allProjects = await getCollection('caseStudies');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const categoryFilters = [
  { key: 'all', label: 'All Case Studies' },
  { key: 'ecommerce', label: categories.ecommerce.label },
  { key: 'shopify', label: categories.shopify.label },
  { key: 'web', label: categories.web.label },
  { key: 'technology', label: categories.technology.label },
];
---

<Layout
  title="Case Studies — E-Commerce, Marketplace & Web Engineering In Depth"
  description="In-depth technical case studies detailing architecture, multi-channel marketplace routing, custom WordPress plugin engineering, and Shopify delivery by 3s-Soft UK."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-20 sm:pt-14 sm:pb-32 space-y-16">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[{ label: 'Case Studies' }]} />

    <!-- Page Header -->
    <div class="max-w-4xl space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-[11px] font-mono tracking-widest text-emerald-400 uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>[ DETAILED CASE ARCHIVE ]</span>
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tighter text-white text-balance leading-[1.05]">
        Work With Substance.
      </h1>

      <p class="text-lg sm:text-2xl text-neutral-300 leading-relaxed max-w-3xl font-normal text-pretty">
        Behind every project is a business challenge. Explore how we approached real digital problems through technology, commerce and thoughtful execution.
      </p>
    </div>

    <!-- Filter Category Pills (Client-side interactive filter) -->
    <div class="flex flex-wrap items-center gap-2 pt-2 border-b border-white/[0.08] pb-6" role="tablist" aria-label="Filter case studies by category">
      {categoryFilters.map((filter, index) => (
        <button
          type="button"
          class:list={[
            'filter-pill px-5 py-2.5 rounded-full text-xs font-mono font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-emerald-400 cursor-pointer',
            index === 0
              ? 'active bg-white text-neutral-950 font-bold shadow-md hover:bg-neutral-100 hover:text-neutral-950'
              : 'bg-[#111413] text-neutral-400 border border-white/[0.08] hover:border-white/[0.2] hover:text-white hover:bg-white/[0.04]',
          ]}
          data-filter={filter.key}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
        >
          {filter.label}
        </button>
      ))}
    </div>

    <!-- Case Studies Grid -->
    <div id="case-studies-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {sortedProjects.map((project, index) => (
        <div
          class="project-item transition-all duration-300"
          data-categories={JSON.stringify(project.data.categories)}
        >
          <ProjectCard
            project={project}
            index={index}
            variant={index === 0 ? 'featured' : 'standard'}
          />
        </div>
      ))}
    </div>

  </div>

  <CTA
    title="Ready to solve your digital challenge?"
    subtitle="Connect with our UK team to discuss your project requirements and see how we can help."
  />
</Layout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const items = document.querySelectorAll<HTMLElement>('.project-item');

  const ACTIVE_CLASSES = ['active', 'bg-white', 'text-neutral-950', 'font-bold', 'shadow-md', 'hover:bg-neutral-100', 'hover:text-neutral-950'];
  const INACTIVE_CLASSES = ['bg-[#111413]', 'text-neutral-400', 'border', 'border-white/[0.08]', 'hover:border-white/[0.2]', 'hover:text-white', 'hover:bg-white/[0.04]'];

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const selected = pill.dataset.filter || 'all';

      pills.forEach((p) => {
        p.classList.remove(...ACTIVE_CLASSES);
        p.classList.add(...INACTIVE_CLASSES);
        p.setAttribute('aria-selected', 'false');
      });

      pill.classList.remove(...INACTIVE_CLASSES);
      pill.classList.add(...ACTIVE_CLASSES);
      pill.setAttribute('aria-selected', 'true');

      items.forEach((item) => {
        const itemCategories: string[] = JSON.parse(item.dataset.categories || '[]');
        if (selected === 'all' || itemCategories.includes(selected)) {
          item.style.display = '';
          item.style.opacity = '1';
        } else {
          item.style.display = 'none';
          item.style.opacity = '0';
        }
      });
    });
  });
</script>
