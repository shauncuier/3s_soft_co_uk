---
import { Image } from 'astro:assets';
import heroImg from '../../assets/projects/tailwater-supply.jpg';
import { site, contactLinks } from '../../data/site';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../icons/WhatsAppIcon.astro';
import { BadgeCheck } from '@lucide/astro';
---

<Section padding="sm" aria-labelledby="hero-heading" class="pt-10 sm:pt-14 lg:pt-16">
  <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-7">
      <Eyebrow class="mb-5">{site.tagline}</Eyebrow>
      <h1 id="hero-heading" class="font-display text-display-xl text-ink">{site.headline}</h1>
      <p class="mt-6 max-w-prose text-lede text-ink-2">
        3s-Soft UK helps small businesses and e-commerce sellers build, fix and grow their online sales, without juggling three different agencies.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={contactLinks.booking} external size="lg">{site.booking.label}</Button>
        {contactLinks.whatsapp && (
          <Button href={contactLinks.whatsapp} external variant="secondary" size="lg">
            <WhatsAppIcon class="size-4" />
            {site.contact.whatsappLabel}
          </Button>
        )}
      </div>
      <p class="mt-6 flex items-start gap-2 text-small text-ink-3">
        <BadgeCheck class="mt-0.5 size-4 shrink-0 text-brand" aria-hidden="true" />
        <span>Free call, fixed-price plan, no obligation. {site.contact.responsePromise}</span>
      </p>
    </div>

    <div class="lg:col-span-5">
      <figure class="relative">
        <div class="overflow-hidden rounded-xl border border-line bg-paper-2 shadow-card-hover">
          <Image
            src={heroImg}
            alt="Tailwater Supply Co. brand website built by 3s-Soft: a fly-fishing storefront with hand-tied flies against a river backdrop"
            width={1200}
            height={900}
            widths={[480, 768, 1024, 1200]}
            sizes="(min-width: 1024px) 460px, 100vw"
            priority
            class="aspect-[4/3] w-full object-cover object-top"
          />
        </div>
        <figcaption class="mt-3 flex items-center justify-between gap-4 text-small text-ink-3">
          <span>Tailwater Supply Co. — brand website for an Amazon &amp; Walmart seller</span>
          <a href="/case-studies/tailwater-supply-co/" class="shrink-0 font-semibold text-brand-700 hover:text-brand-800">Case study</a>
        </figcaption>
      </figure>
    </div>
  </div>
</Section>
