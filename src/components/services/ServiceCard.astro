---
import { ArrowRight } from '@lucide/astro';

interface Props {
  title: string;
  forWho: string;
  bullets?: readonly string[];
  href: string;
  headingLevel?: 'h2' | 'h3';
}
const { title, forWho, bullets = [], href, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="group relative flex h-full flex-col rounded-lg border border-line bg-surface p-6 shadow-card transition-[box-shadow,border-color] duration-180 ease-soft hover:border-line-strong hover:shadow-card-hover focus-within:ring-2 focus-within:ring-brand focus-within:ring-offset-2 focus-within:ring-offset-paper sm:p-7">
  <Heading class="text-display-sm text-ink">
    <a href={href} class="outline-none after:absolute after:inset-0 after:content-['']">{title}</a>
  </Heading>
  <p class="mt-3 text-ink-2">{forWho}</p>
  {bullets.length > 0 && (
    <ul class="mt-5 space-y-1.5 text-small text-ink-2">
      {bullets.map((b) => (
        <li class="flex gap-2">
          <span class="mt-[0.55em] size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
          {b}
        </li>
      ))}
    </ul>
  )}
  <span class="mt-auto inline-flex items-center gap-1.5 pt-6 font-semibold text-brand-700 group-hover:text-brand-800">
    Learn more
    <ArrowRight class="size-4 transition-transform duration-180 group-hover:translate-x-0.5" aria-hidden="true" />
  </span>
</article>
