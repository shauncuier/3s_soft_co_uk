---
import { whyUs } from '../../data/content';
import { site, contactLinks } from '../../data/site';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { Phone, Check } from '@lucide/astro';
---

<Section tone="graphite" inset aria-labelledby="why-heading" class="py-3">
  <div class="mx-auto max-w-4xl text-center" data-reveal>
    <Eyebrow tone="on-dark" chip class="mx-auto">Our point of view</Eyebrow>
    <h2 id="why-heading" class="mt-6 font-display text-display-lg text-paper">
      Most agencies build for big brands. We build for <span class="text-brand-100">small businesses and independent sellers</span>, so the store, the listings and the website finally work as one.
    </h2>
  </div>
  <div class="mt-14 grid gap-10 lg:grid-cols-12">
    <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-7">
      {whyUs.map((item, i) => (
        <li class="flex gap-4" data-reveal data-reveal-delay={String(Math.min(i, 3))}>
          <span class="mt-1 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-brand text-white"><Check class="size-4" aria-hidden="true" /></span>
          <div>
            <h3 class="text-display-sm text-paper">{item.title}</h3>
            <p class="mt-2 text-on-graphite-2">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="lg:col-span-5" data-reveal data-reveal-delay="2">
      <div class="rounded-xl bg-paper p-7 text-ink shadow-card sm:p-8">
        <p class="eyebrow text-ink-3">Your UK point of contact</p>
        <p class="mt-3 text-display-sm text-ink">{site.ukDirector.name}</p>
        <p class="text-small font-semibold text-brand-700">{site.ukDirector.role}</p>
        <p class="mt-4 text-ink-2">{site.ukDirector.summary}</p>
        <div class="mt-6 flex flex-col gap-3">
          <Button href={contactLinks.booking} external arrow>{site.booking.label}</Button>
          {contactLinks.phone && (
            <a href={contactLinks.phone} class="inline-flex items-center gap-2 font-semibold text-ink hover:text-brand-700">
              <Phone class="size-4 text-brand" aria-hidden="true" />
              {site.contact.phoneDisplay}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</Section>
