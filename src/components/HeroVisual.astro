---
import { Image } from 'astro:assets';
import storefrontImg from '../assets/projects/shopify-storefront.jpg';
import marketplaceImg from '../assets/projects/marketplace-operations.jpg';
import mobileImg from '../assets/projects/mobile-commerce.jpg';
import productDataImg from '../assets/projects/product-data.jpg';
import automationImg from '../assets/projects/automation.jpg';
import corporateImg from '../assets/projects/corporate-website.jpg';
import { ArrowUpRight, CheckCircle2, ShieldCheck, Zap } from '@lucide/astro';
---

<div class="relative w-full mx-auto mt-14 lg:mt-20 select-none" aria-hidden="true">
  
  <!-- Subtle ambient glow in background -->
  <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-4/5 h-80 bg-emerald-500/[0.08] rounded-full blur-3xl pointer-events-none"></div>

  <!-- Flagship Device / Showcase Container with Precision Border -->
  <div class="relative z-10 rounded-2xl sm:rounded-3xl bg-[#111413] border border-white/[0.12] shadow-2xl overflow-hidden">
    
    <!-- Editorial Browser Chrome -->
    <div class="flex items-center justify-between px-5 py-3.5 bg-black/60 border-b border-white/[0.08] backdrop-blur-md">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-white/[0.12]"></span>
        <span class="w-3 h-3 rounded-full bg-white/[0.12]"></span>
        <span class="w-3 h-3 rounded-full bg-white/[0.12]"></span>
        <span class="ml-3 text-[11px] font-mono text-neutral-400 hidden sm:inline-block">
          3s-soft.co.uk // showcase-hub
        </span>
      </div>

      <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/[0.08] text-[11px] font-mono text-neutral-300">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>PRODUCTION DEPLOYMENTS</span>
      </div>

      <div class="hidden sm:flex items-center gap-3 text-[11px] font-mono text-neutral-400">
        <span>UK · LONDON</span>
      </div>
    </div>

    <!-- Interactive / Multi-Project Showcase Grid -->
    <div class="grid grid-cols-12 gap-0 lg:divide-x divide-white/[0.08]">
      
      <!-- Primary Featured Canvas (8 cols on desktop) -->
      <div class="col-span-12 lg:col-span-8 relative aspect-[16/10] sm:aspect-[16/9] lg:aspect-auto lg:h-[480px] bg-[#0c0e0d] overflow-hidden group">
        <Image
          src={storefrontImg}
          alt="Modern Shopify digital commerce storefront preview"
          width={1200}
          height={750}
          class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          loading="eager"
        />
        
        <!-- Bottom Floating Glass Metadata Tag -->
        <div class="absolute bottom-5 left-5 right-5 sm:right-auto flex items-center justify-between sm:justify-start gap-4 p-3.5 rounded-2xl bg-[#090b0a]/90 backdrop-blur-xl border border-white/[0.12] shadow-xl">
          <div class="space-y-0.5">
            <span class="text-[10px] font-mono uppercase tracking-widest text-emerald-400 font-bold block">
              Case Study 01 // Shopify Plus
            </span>
            <span class="text-sm font-bold text-white block">
              Handcrafted Ceramics Storefront
            </span>
          </div>
          <a
            href="/case-studies/nordic-homeware-shopify/"
            class="p-2 rounded-xl bg-white/[0.1] hover:bg-emerald-500 hover:text-black transition-colors text-white"
            aria-label="View case study"
          >
            <ArrowUpRight class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Secondary Stacked Visual Highlights (4 cols on desktop) -->
      <div class="col-span-12 lg:col-span-4 flex flex-col divide-y divide-white/[0.08] bg-[#0d100f]">
        
        <!-- Marketplace Operations Highlight -->
        <div class="p-5 space-y-3 group hover:bg-white/[0.02] transition-colors">
          <div class="flex items-center justify-between text-[11px] font-mono">
            <span class="text-neutral-400">02 // MARKETPLACES</span>
            <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-semibold border border-emerald-500/20">AMAZON &amp; EBAY</span>
          </div>
          <div class="rounded-xl overflow-hidden border border-white/[0.08] aspect-[16/8] bg-black">
            <Image
              src={marketplaceImg}
              alt="Multi-channel marketplace listing management"
              width={400}
              height={200}
              class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
          </div>
          <p class="text-xs text-neutral-300 font-medium">
            Unified catalog health, inventory feeds, and listing syndication.
          </p>
        </div>

        <!-- Custom Technology & Automation Highlight -->
        <div class="p-5 space-y-3 group hover:bg-white/[0.02] transition-colors">
          <div class="flex items-center justify-between text-[11px] font-mono">
            <span class="text-neutral-400">03 // AUTOMATION</span>
            <span class="px-2 py-0.5 rounded bg-white/[0.05] text-neutral-300 font-semibold border border-white/[0.1]">EVENT-DRIVEN</span>
          </div>
          <div class="rounded-xl overflow-hidden border border-white/[0.08] aspect-[16/8] bg-black">
            <Image
              src={automationImg}
              alt="Custom webhook integration and order sync pipeline"
              width={400}
              height={200}
              class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <p class="text-xs text-neutral-300 font-medium">
            Multi-warehouse inventory synchronization &amp; carrier webhooks.
          </p>
        </div>

      </div>

    </div>

    <!-- Bottom Architectural Telemetry Bar -->
    <div class="px-6 py-4 bg-black/80 border-t border-white/[0.08] flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-neutral-400">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5 text-neutral-300">
          <Zap class="w-3.5 h-3.5 text-emerald-400" />
          <span>Core Web Vitals: 98+</span>
        </span>
        <span class="hidden sm:flex items-center gap-1.5 text-neutral-300">
          <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
          <span>UK British English &amp; VAT Standards</span>
        </span>
      </div>

      <a
        href="/work/"
        class="inline-flex items-center gap-1 text-emerald-400 hover:text-emerald-300 transition-colors font-sans font-semibold text-xs"
      >
        <span>Explore All 6 Case Studies</span>
        <ArrowUpRight class="w-3.5 h-3.5" />
      </a>
    </div>

  </div>

</div>
