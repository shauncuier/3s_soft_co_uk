---
import { site } from '../../data/site';
import { ArrowUpRight, BadgeCheck } from '@lucide/astro';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const items = [...site.credentials.map((c) => ({ label: c.label, detail: c.detail, href: c.href })), { label: site.reach, detail: 'Across e-commerce, marketplaces and web projects', href: '' }];
---

<ul class:list={['grid gap-4 sm:grid-cols-2', className]}>
  {items.map((c) => (
    <li class="flex gap-3 rounded-lg border border-line bg-surface p-5 shadow-card">
      <BadgeCheck class="mt-0.5 size-5 shrink-0 text-brand" aria-hidden="true" />
      <div>
        <p class="font-semibold text-ink">{c.label}</p>
        {c.href ? (
          <a href={c.href} target="_blank" rel="noopener noreferrer" class="mt-0.5 inline-flex items-center gap-1 text-small text-brand-700 hover:text-brand-800">
            {c.detail} <ArrowUpRight class="size-3.5" aria-hidden="true" />
          </a>
        ) : (
          <p class="mt-0.5 text-small text-ink-3">{c.detail}</p>
        )}
      </div>
    </li>
  ))}
</ul>
