---
/**
 * Case-study card. The title link is stretched over the card so the
 * accessible name stays short; the card shows the focus ring.
 */
import { Image } from 'astro:assets';
import type { CaseStudy } from '../../utils/caseStudies';
import Tag from '../ui/Tag.astro';

interface Props {
  project: CaseStudy;
  headingLevel?: 'h2' | 'h3';
  featured?: boolean;
  eager?: boolean;
  class?: string;
}

const { project, headingLevel: Heading = 'h3', featured = false, eager = false, class: className = '' } = Astro.props;
const { data, id } = project;
const href = `/case-studies/${id}/`;
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-xl border border-line bg-surface shadow-card hover-lift hover:shadow-card-hover focus-within:ring-2 focus-within:ring-brand focus-within:ring-offset-2 focus-within:ring-offset-paper',
    featured && 'md:col-span-2 md:grid md:grid-cols-2',
    className,
  ]}
>
  <div class:list={['flex flex-col overflow-hidden bg-paper-2', featured ? 'md:h-full' : '']}>
    <div class="flex items-center gap-1.5 border-b border-line bg-paper-2 px-4 py-2" aria-hidden="true">
      <span class="size-2 rounded-full bg-line-strong"></span><span class="size-2 rounded-full bg-line-strong"></span><span class="size-2 rounded-full bg-line-strong"></span>
    </div>
    <Image
      src={data.heroImage}
      alt={data.heroAlt}
      width={featured ? 1200 : 800}
      height={featured ? 900 : 600}
      widths={featured ? [480, 768, 1024, 1200] : [400, 640, 800]}
      sizes={featured ? '(min-width: 1152px) 560px, (min-width: 768px) 50vw, 100vw' : '(min-width: 1152px) 360px, (min-width: 768px) 33vw, 100vw'}
      loading={eager ? 'eager' : 'lazy'}
      class:list={['w-full object-cover object-top transition-transform duration-500 ease-soft group-hover:scale-[1.02]', featured ? 'aspect-[4/3] md:aspect-auto md:h-full md:flex-1' : 'aspect-[4/3]']}
    />
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <div class="flex flex-wrap items-center gap-2">
      <Tag tone="brand">{data.categoryLabel}</Tag>
      <span class="text-small text-ink-3">{data.year}</span>
    </div>
    <Heading class:list={['mt-4 font-bold text-ink', featured ? 'text-display-md' : 'text-display-sm']}>
      <a href={href} class="outline-none after:absolute after:inset-0 after:content-['']">
        {data.title}
      </a>
    </Heading>
    <p class="mt-3 text-ink-2">{data.tagline}</p>
    <p class="mt-auto pt-5 text-small text-ink-3">{data.client}</p>
  </div>
</article>
