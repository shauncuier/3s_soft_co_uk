---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'caseStudies'>;
  variant?: 'featured' | 'standard' | 'compact';
  class?: string;
}

const { project, variant = 'standard', class: className = '' } = Astro.props;
const { data, id } = project;
const caseStudyUrl = `/case-studies/${id}/`;
---

<article
  class:list={[
    'group relative flex flex-col rounded-2xl bg-white border border-surface-border overflow-hidden transition-all duration-300 hover:shadow-xl hover:border-neutral-300',
    variant === 'featured' && 'md:col-span-2 lg:grid lg:grid-cols-12 lg:items-center',
    className,
  ]}
>
  <!-- Project Visual Container -->
  <div
    class:list={[
      'relative overflow-hidden bg-neutral-100',
      variant === 'featured' ? 'lg:col-span-7 h-72 sm:h-96 lg:h-full min-h-[340px]' : 'aspect-[16/10] sm:aspect-[4/3]',
    ]}
  >
    <a href={caseStudyUrl} tabindex="-1" aria-hidden="true" class="block h-full w-full">
      <Image
        src={data.heroImage}
        alt={data.heroAlt}
        width={variant === 'featured' ? 1200 : 800}
        height={variant === 'featured' ? 800 : 600}
        class="h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        loading="lazy"
      />
    </a>

    <!-- Category Pill Badge -->
    <div class="absolute top-4 left-4 z-10">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/90 backdrop-blur-md text-text-primary border border-surface-border shadow-xs">
        {data.categoryLabel}
      </span>
    </div>

    {data.placeholder && (
      <div class="absolute top-4 right-4 z-10">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium uppercase tracking-wider bg-black/60 backdrop-blur-md text-white">
          Demo Project
        </span>
      </div>
    )}
  </div>

  <!-- Project Details -->
  <div
    class:list={[
      'flex flex-col justify-between p-6 sm:p-8',
      variant === 'featured' ? 'lg:col-span-5' : 'flex-1',
    ]}
  >
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-semibold text-text-muted uppercase tracking-wider">
        <span>{data.industry}</span>
        <span>·</span>
        <span>{data.year}</span>
      </div>

      <h3 class="text-xl sm:text-2xl font-bold text-text-primary tracking-tight group-hover:text-brand-green transition-colors duration-200">
        <a href={caseStudyUrl} class="focus:outline-none">
          <span class="absolute inset-0 z-0 pointer-events-auto" aria-hidden="true"></span>
          {data.title}
        </a>
      </h3>

      <p class="text-sm sm:text-base text-text-secondary leading-relaxed line-clamp-3">
        {data.summary}
      </p>

      {data.platforms.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-2">
          {data.platforms.slice(0, 4).map((tech) => (
            <span class="text-xs font-medium px-2.5 py-1 rounded bg-surface-bg text-text-secondary border border-surface-border">
              {tech}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- View Case Study Link -->
    <div class="pt-6 mt-6 border-t border-surface-border flex items-center justify-between text-sm font-semibold text-text-primary group-hover:text-brand-green transition-colors">
      <span class="inline-flex items-center gap-1.5">
        View Case Study
      </span>
      <div class="w-8 h-8 rounded-full bg-surface-bg border border-surface-border flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1 group-hover:bg-brand-green group-hover:text-white group-hover:border-transparent">
        <ArrowUpRight class="w-4 h-4" />
      </div>
    </div>
  </div>
</article>
