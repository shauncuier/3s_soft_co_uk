---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Check, ExternalLink, Lightbulb, TrendingUp } from '@lucide/astro';

interface Props {
  project: CollectionEntry<'caseStudies'>;
}

const { project } = Astro.props;
const { data } = project;
---

<div class="space-y-20 sm:space-y-28">
  
  <!-- Narrative: Challenge, Approach & Solution (2-column editorial layout) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
    
    <!-- Left Sticky Sidebar: Services & Technologies (4 cols) -->
    <div class="lg:col-span-4 space-y-8 lg:sticky lg:top-28 self-start">
      
      {data.liveUrl && (
        <div class="rounded-3xl p-6 bg-gradient-to-br from-emerald-950/40 via-[#111413] to-[#111413] border border-emerald-500/20 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-emerald-400">
              [ LIVE DEPLOYMENT ]
            </span>
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>
          <p class="text-xs text-neutral-300">
            This project is live and verified in production.
          </p>
          <a
            href={data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-xl text-xs font-mono font-bold uppercase tracking-wider bg-emerald-400 text-neutral-950 hover:bg-emerald-300 transition-colors shadow-lg shadow-emerald-500/10"
          >
            <span>Visit Live Site</span>
            <ExternalLink class="w-3.5 h-3.5 stroke-[2.5]" />
          </a>
        </div>
      )}

      {data.services.length > 0 && (
        <div class="rounded-3xl p-8 bg-[#111413] border border-white/[0.08] space-y-4">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-400">
            [ SCOPE &amp; SERVICES ]
          </h3>
          <ul class="space-y-2.5 text-sm font-medium text-neutral-200">
            {data.services.map((service) => (
              <li class="flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>{service}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {data.platforms.length > 0 && (
        <div class="rounded-3xl p-8 bg-[#111413] border border-white/[0.08] space-y-4">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-400">
            [ TECHNOLOGIES ]
          </h3>
          <div class="flex flex-wrap gap-2">
            {data.platforms.map((tech) => (
              <span class="text-xs font-mono px-3 py-1.5 rounded-xl bg-white/[0.04] text-neutral-300 border border-white/[0.08]">
                {tech}
              </span>
            ))}
          </div>
        </div>
      )}

      {data.bestForPitching && (
        <div class="rounded-3xl p-6 bg-[#111413] border border-white/[0.08] space-y-3">
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-neutral-400">
            [ FIT &amp; AUDIENCE ]
          </span>
          <p class="text-xs font-mono text-emerald-400 font-semibold leading-relaxed">
            {data.bestForPitching}
          </p>
        </div>
      )}

    </div>

    <!-- Right Main Narrative (8 cols) -->
    <div class="lg:col-span-8 space-y-14 sm:space-y-18 text-neutral-300">
      
      <!-- Challenge Block -->
      <section class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-[11px] font-mono tracking-widest text-emerald-400 uppercase">
          <span>01 // THE CHALLENGE</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          What the business needed
        </h2>
        <p class="text-base sm:text-lg text-neutral-300 leading-relaxed font-normal">
          {data.challenge}
        </p>
      </section>

      <!-- Approach Block -->
      <section class="space-y-4 pt-10 border-t border-white/[0.08]">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-[11px] font-mono tracking-widest text-emerald-400 uppercase">
          <span>02 // OUR APPROACH</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          How we approached the problem
        </h2>
        <p class="text-base sm:text-lg text-neutral-300 leading-relaxed font-normal">
          {data.approach}
        </p>
      </section>

      <!-- Solution Block -->
      <section class="space-y-4 pt-10 border-t border-white/[0.08]">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-[11px] font-mono tracking-widest text-emerald-400 uppercase">
          <span>03 // THE SOLUTION</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          What was built &amp; improved
        </h2>
        <p class="text-base sm:text-lg text-neutral-300 leading-relaxed font-normal">
          {data.solution}
        </p>
      </section>

      <!-- MDX Body (Implementation details) -->
      <div class="prose prose-invert prose-emerald max-w-none pt-10 border-t border-white/[0.08]">
        <slot />
      </div>

      <!-- Qualitative Outcomes / Results -->
      <section class="rounded-3xl p-8 sm:p-10 bg-[#111413] border border-white/[0.1] space-y-6">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-400">
              [ OUTCOMES &amp; DELIVERABLES ]
            </span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Key Business Outcomes
          </h3>
          {data.resultsNote ? (
            <p class="text-xs font-mono text-emerald-300/80 bg-emerald-500/10 p-3 rounded-xl border border-emerald-500/20">
              Status note: {data.resultsNote}
            </p>
          ) : (
            <p class="text-xs font-mono text-neutral-400">
              * Verified qualitative operational outcomes and commercial improvements.
            </p>
          )}
        </div>

        <ul class="space-y-4 pt-2" role="list">
          {data.outcome.map((item) => (
            <li class="flex items-start gap-3.5 text-sm sm:text-base text-neutral-300">
              <div class="w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center shrink-0 mt-0.5">
                <Check class="w-3.5 h-3.5 stroke-[2.5]" />
              </div>
              <span class="leading-snug">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Next Recommended Improvements Roadmap (if defined) -->
      {data.nextImprovements && data.nextImprovements.length > 0 && (
        <section class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-[#121614] to-[#0c0e0d] border border-emerald-500/20 space-y-6">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-mono tracking-widest text-emerald-400 uppercase">
              <Lightbulb class="w-3.5 h-3.5" />
              <span>OPTIMISATION ROADMAP</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
              Recommended Next Improvements
            </h3>
            <p class="text-xs font-mono text-neutral-400">
              Tactical engineering and data upgrades recommended for the next growth sprint.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            {data.nextImprovements.map((item, idx) => (
              <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.06] space-y-2">
                <span class="text-[10px] font-mono text-emerald-400 uppercase tracking-widest font-bold">
                  STEP 0{idx + 1}
                </span>
                <p class="text-xs sm:text-sm text-neutral-200 leading-relaxed">
                  {item}
                </p>
              </div>
            ))}
          </div>
        </section>
      )}

    </div>

  </div>

  <!-- Visual Gallery -->
  {data.gallery && data.gallery.length > 0 && (
    <section class="space-y-8 pt-12 border-t border-white/[0.08]">
      <div class="space-y-2">
        <span class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-400">
          [ 04 // GALLERY ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Selected Project Details
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {data.gallery.map((item) => (
          <figure class="space-y-3">
            <div class="rounded-3xl overflow-hidden bg-black border border-white/[0.1] shadow-xl">
              <Image
                src={item.image}
                alt={item.alt}
                width={900}
                height={600}
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            {item.caption && (
              <figcaption class="text-xs font-mono text-neutral-400 px-2">
                {item.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </section>
  )}

</div>
