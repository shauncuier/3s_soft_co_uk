---
import Layout from '../../layouts/Layout.astro';
import WorkListing from '../../components/work/WorkListing.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import { getPublishedCaseStudies } from '../../utils/caseStudies';

const projects = await getPublishedCaseStudies();
---

<Layout
  title="Our Work — Shopify, Amazon and Web Projects for UK Businesses"
  description="Real projects for real brands: Amazon A+ Content and Brand Stories, Shopify and WordPress storefronts, and the automation that keeps stock and prices in sync."
  pageType="CollectionPage"
  breadcrumbs={[{ label: 'Work' }]}
>
  <WorkListing
    projects={projects}
    heading="Work that's live and earning."
    lede="Every project here is real, named and linked. No mock-ups, no 'demo briefs'. Click through to see what the brief was, what we built and what changed."
    breadcrumbs={[{ label: 'Work' }]}
  />
  <CtaBand title="Want something like this for your business?" lede="Tell us what you sell and where. We'll suggest the smallest piece of work that would make a difference." />
</Layout>
