---
interface Props {
  as?: 'div' | 'article' | 'li' | 'a';
  href?: string;
  padding?: 'default' | 'sm' | 'lg' | 'none';
  interactive?: boolean;
  tone?: 'surface' | 'paper-2' | 'brand-50' | 'graphite-2';
  class?: string;
}

const {
  as,
  href,
  padding = 'default',
  interactive = false,
  tone = 'surface',
  class: className = '',
} = Astro.props;

const Tag = as ?? (href ? 'a' : 'div');
const paddings = { default: 'p-6 sm:p-8', sm: 'p-5', lg: 'p-8 sm:p-10', none: '' };
const tones = {
  surface: 'bg-surface border-line',
  'paper-2': 'bg-paper-2 border-line',
  'brand-50': 'bg-brand-50 border-brand-100',
  'graphite-2': 'bg-graphite-2 border-white/10 text-on-graphite',
};
---

<Tag
  href={href}
  class:list={[
    'block rounded-lg border shadow-card',
    tones[tone],
    paddings[padding],
    interactive && 'transition-[box-shadow,border-color] duration-180 ease-soft hover:shadow-card-hover hover:border-line-strong',
    className,
  ]}
>
  <slot />
</Tag>
