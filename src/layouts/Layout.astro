---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';
import { buildSchemaGraph, type BreadcrumbItem, type CaseStudySchemaInput } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  breadcrumbs?: BreadcrumbItem[];
  caseStudy?: CaseStudySchemaInput;
}

const {
  title,
  description = site.description,
  ogImage = '/og-default.png',
  canonicalUrl,
  noindex = false,
  pageType = 'WebPage',
  breadcrumbs,
  caseStudy,
} = Astro.props;

// Page Title Formatting: "Title | 3s-Soft UK" or Default Brand
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const formattedTitle = isHome
  ? `${site.ukName} — Digital Commerce, Shopify & Web Technology Partner`
  : (title ? `${title} | ${site.ukName}` : `${site.ukName} | ${site.positioning}`);

// Canonical URL derivation with trailing slash consistency
const cleanPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = canonicalUrl || new URL(cleanPath, site.url).href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, site.url).href;

// Unified Schema.org @graph JSON-LD
const schemaGraph = buildSchemaGraph({
  pathname: cleanPath,
  pageTitle: formattedTitle,
  pageDescription: description,
  pageType,
  breadcrumbs,
  caseStudy,
  ogImageUrl: fullOgImage,
});
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Technical SEO -->
    <title>{formattedTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="3s-Soft UK" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      </>
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.ukName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="3s-Soft UK — Digital Commerce & Technology Partner" />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:site" content="@3ssoft" />
    <meta name="twitter:creator" content="@3ssoft" />

    <!-- Favicons & App Icons (derived directly from official 3s-Soft brand) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#121514" />

    <!-- Structured Data (Unified Schema.org JSON-LD @graph) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body class="min-h-screen flex flex-col bg-surface-bg text-text-primary antialiased">
    
    <!-- Skip to main content link for keyboard accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-text-primary text-white font-semibold rounded-md shadow-lg"
    >
      Skip to main content
    </a>

    <Header currentPath={Astro.url.pathname} />

    <main id="main-content" class="flex-1 focus:outline-none">
      <slot />
    </main>

    <WhatsAppButton />

    <Footer />
  </body>
</html>
