---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'caseStudies'>;
  variant?: 'featured' | 'standard' | 'compact';
  index?: number;
  class?: string;
}

const { project, variant = 'standard', index, class: className = '' } = Astro.props;
const { data, id } = project;
const caseStudyUrl = `/case-studies/${id}/`;
---

<article
  class:list={[
    'group relative flex flex-col rounded-3xl bg-[#111413] border border-white/[0.08] overflow-hidden transition-all duration-300 hover:border-white/[0.22] hover:shadow-2xl hover:shadow-black/50',
    variant === 'featured' && 'md:col-span-2 lg:grid lg:grid-cols-12 lg:items-stretch',
    className,
  ]}
>
  <!-- Project Visual Frame -->
  <div
    class:list={[
      'relative overflow-hidden bg-[#0c0e0d]',
      variant === 'featured' ? 'lg:col-span-7 min-h-[360px] lg:min-h-[440px]' : 'aspect-[16/10] sm:aspect-[4/3]',
    ]}
  >
    <a href={caseStudyUrl} tabindex="-1" aria-hidden="true" class="block h-full w-full">
      <Image
        src={data.heroImage}
        alt={data.heroAlt}
        width={variant === 'featured' ? 1200 : 800}
        height={variant === 'featured' ? 800 : 600}
        class="h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        loading="lazy"
      />
    </a>

    <!-- Category Pill Badge -->
    <div class="absolute top-4 left-4 z-10 flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-black/80 backdrop-blur-md text-emerald-400 border border-white/[0.12] shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>{data.categoryLabel}</span>
      </span>
      {typeof index === 'number' && (
        <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-mono text-neutral-400 bg-black/60 border border-white/[0.08]">
          0{index + 1}
        </span>
      )}
    </div>

    {data.placeholder && (
      <div class="absolute top-4 right-4 z-10">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase tracking-wider bg-white/[0.1] backdrop-blur-md text-neutral-300 border border-white/[0.15]">
          Demo Brief
        </span>
      </div>
    )}
  </div>

  <!-- Project Details Content -->
  <div
    class:list={[
      'flex flex-col justify-between p-6 sm:p-8 lg:p-10 bg-[#111413]',
      variant === 'featured' ? 'lg:col-span-5' : 'flex-1',
    ]}
  >
    <div class="space-y-4">
      <div class="flex items-center gap-3 text-xs font-mono text-neutral-400">
        <span>{data.industry}</span>
        <span class="text-neutral-600">//</span>
        <span>{data.year}</span>
      </div>

      <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight group-hover:text-emerald-400 transition-colors duration-200">
        <a href={caseStudyUrl} class="focus:outline-none">
          <span class="absolute inset-0 z-0 pointer-events-auto" aria-hidden="true"></span>
          {data.title}
        </a>
      </h3>

      <p class="text-sm sm:text-base text-neutral-400 leading-relaxed line-clamp-3 font-normal">
        {data.summary}
      </p>

      {data.platforms.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-2">
          {data.platforms.slice(0, 4).map((tech) => (
            <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/[0.04] text-neutral-300 border border-white/[0.08]">
              {tech}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Case Study Action Link -->
    <div class="pt-6 mt-6 border-t border-white/[0.08] flex items-center justify-between text-xs font-bold font-mono uppercase tracking-wider text-neutral-300 group-hover:text-emerald-400 transition-colors">
      <span class="inline-flex items-center gap-2">
        <span>View Full Case Study</span>
      </span>
      <div class="w-9 h-9 rounded-full bg-white/[0.05] border border-white/[0.1] flex items-center justify-center transition-all duration-300 group-hover:bg-emerald-500 group-hover:border-transparent group-hover:translate-x-1">
        <ArrowUpRight class="w-4 h-4 text-neutral-300 group-hover:text-neutral-950 transition-colors" />
      </div>
    </div>
  </div>
</article>
