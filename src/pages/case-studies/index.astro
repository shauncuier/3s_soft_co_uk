---
/** Alias of /work/ kept because the URL is already indexed; canonical points to /work/. */
import Layout from '../../layouts/Layout.astro';
import WorkListing from '../../components/work/WorkListing.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import { getPublishedCaseStudies } from '../../utils/caseStudies';
import { site } from '../../data/site';

const projects = await getPublishedCaseStudies();
---

<Layout
  title="Case Studies — Shopify, Amazon and Web Projects for UK Businesses"
  description="Real projects for real brands: Amazon A+ Content and Brand Stories, Shopify and WordPress storefronts, and the automation that keeps stock and prices in sync."
  pageType="CollectionPage"
  canonicalUrl={`${site.url}/work/`}
  breadcrumbs={[{ label: 'Case studies' }]}
>
  <WorkListing
    projects={projects}
    eyebrow="Case studies"
    heading="Work that's live and earning."
    lede="Every project here is real, named and linked. Click through to see what the brief was, what we built and what changed."
    breadcrumbs={[{ label: 'Case studies' }]}
  />
  <CtaBand />
</Layout>
